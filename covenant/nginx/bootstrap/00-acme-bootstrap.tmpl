# TEMPORARY first-boot site: port 80 only, ACME http-01 webroot for every name.
# deploy.sh enables this alone (no 443 servers, which would need certs that
# don't exist yet), issues the certs, then replaces it with the full sites.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${SPARK_DOMAIN} ${SPARK_CHAT_HOST} ${SPARK_API_HOST} ${SPARK_ID_HOST} ${SPARK_TELEMETRY_HOST} ${SPARK_DIGEST_HOST};
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        return 444;
    }
}
