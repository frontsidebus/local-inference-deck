# chat. -> Open WebUI on Walter
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${SPARK_CHAT_HOST};
    ssl_certificate     /etc/letsencrypt/live/${SPARK_CHAT_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SPARK_CHAT_HOST}/privkey.pem;
    include snippets/tls-common.conf;

    client_max_body_size 50m;
    proxy_buffering      off;
    proxy_read_timeout   900s;
    proxy_send_timeout   900s;

    # session check (GET on every page load) - not rate limited
    location = /api/v1/auths/ {
        include snippets/proxy-common.conf;
        proxy_pass http://${BACKEND_WG_IP}:${WEBUI_PORT};
    }
    # login / signup / auth actions - rate limited
    location /api/v1/auths/ {
        limit_req zone=chat_login burst=10 nodelay;
        include snippets/proxy-common.conf;
        proxy_pass http://${BACKEND_WG_IP}:${WEBUI_PORT};
    }
    location / {
        include snippets/proxy-common.conf;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass http://${BACKEND_WG_IP}:${WEBUI_PORT};
    }
}
