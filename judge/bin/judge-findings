#!/usr/bin/env python3
"""judge-findings [options] [request-id]

List or summarize judge findings in $JUDGE_REVIEW_DIR/findings/.

Every item has a status:
  open          not acknowledged (C5 keeps showing it to the agent)
  agent-acked   a HIGH item acknowledged only by the agent: no longer injected, awaits a human
  closed        acknowledged by a human, or by the agent when its severity is not high

  (no args)              one line per finding from the last 7 days: counts by severity and by status
  <request-id>           every item of that finding, grouped by status
  --items                every item (not one line per finding), grouped by status, filtered as below
  --unacked              only items with no acknowledgement at all (implies --items)
  --needs-human          only HIGH items no human has closed: open or agent-acked (implies --items)
  --min-severity LEVEL   low|medium|high (default low)
  --since HOURS          only findings created in the last HOURS (default 168; 0 = all)
  --json                 machine-readable output (each item gets "acked", "status" and "ack")
Runner health (#41), printed to stderr first: a WARNING when the oldest ready review request has waited longer
than JUDGE_STALL_MINUTES (default 15) with no runner busy, and when `systemctl --user is-failed` reports a
judge-review unit failed (skipped when JUDGE_CHECK_UNITS=0 or systemctl is missing). Both print the fix command.
Colors are used only when stdout is a TTY and NO_COLOR is unset.
"""
import json
import os
import shutil
import subprocess
import sys
from datetime import timedelta
from pathlib import Path

JUDGE_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(JUDGE_DIR / "runner"))
sys.path.insert(0, str(JUDGE_DIR))
import common as C  # noqa: E402
from lib import queue as Q  # noqa: E402

COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
SEV_COLOR = {"high": "31;1", "medium": "33", "low": "36"}
STATUS_COLOR = {"open": "1", "agent-acked": "35", "closed": "32"}
GROUPS = (("open", "open"), ("agent-acked", "agent-acked: awaiting a human"), ("closed", "closed"))


def paint(text, code):
    return f"\033[{code}m{text}\033[0m" if COLOR and code else text


def sev(s):
    return paint(f"{str(s).upper():<6}", SEV_COLOR.get(str(s), ""))


def parse(argv):
    opts = {"items": False, "unacked": False, "needs_human": False, "min": "low", "since": 168.0, "json": False,
            "rid": None}
    it = iter(argv)
    for a in it:
        if a in ("-h", "--help"):
            print(__doc__.strip())
            sys.exit(0)
        elif a == "--items":
            opts["items"] = True
        elif a == "--unacked":
            opts["unacked"] = opts["items"] = True
        elif a == "--needs-human":
            opts["needs_human"] = opts["items"] = True
        elif a == "--json":
            opts["json"] = True
        elif a == "--min-severity":
            opts["min"] = next(it, "low").lower()
        elif a == "--since":
            opts["since"] = float(next(it, "168"))
        elif not a.startswith("-") and opts["rid"] is None:
            opts["rid"] = a
        else:
            print(f"judge-findings: unknown argument {a}", file=sys.stderr)
            sys.exit(64)
    if opts["min"] not in C.SEVERITY_RANK:
        print("judge-findings: --min-severity must be low, medium or high", file=sys.stderr)
        sys.exit(64)
    return opts


def ack_info(rid, iid, root, paths):
    a = Q.read_ack(rid, iid, root)
    if a is None:
        return None
    actor = Q.ack_actor(rid, iid, root, paths)
    out = {"actor": actor, "reason": a.get("reason", ""), "ts": a.get("ts", "")}
    if actor != a["actor"]:
        out["claimed_actor"] = a["actor"]  # the file says human, but an agent tool call wrote it
    if a.get("legacy"):
        out["legacy"] = True
    return out


def describe_ack(it):
    a = it.get("ack")
    if not a:
        return ""
    who = a["actor"] + (f" (file claims {a['claimed_actor']}; written by an agent tool call)"
                        if a.get("claimed_actor") else "")
    return f"     ack: {who} {a.get('ts', '')}: {a.get('reason', '')}"


UNITS = ("judge-review.service", "judge-review.path", "judge-review.timer")


def failed_units():
    """judge-review units systemd reports as failed ([] when unknown, or JUDGE_CHECK_UNITS=0)."""
    if os.environ.get("JUDGE_CHECK_UNITS", "1") == "0" or not shutil.which("systemctl"):
        return []
    try:
        p = subprocess.run(["systemctl", "--user", "is-failed", *UNITS], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return []
    states = p.stdout.split()
    return [u for u, s in zip(UNITS, states) if s.strip() == "failed"]


def health_warnings(root):
    out = []
    bad = failed_units()
    if bad:
        out.append(f"WARNING: judge runner is not running: {' '.join(bad)} failed. Fix: systemctl --user "
                   "reset-failed judge-review.service judge-review.path && systemctl --user start judge-review.path")
    try:
        st = Q.stall_status(root)
    except Exception:
        st = None
    if st:
        out.append(Q.stall_line(st))
    return out


def main(argv):
    o = parse(argv)
    floor = C.SEVERITY_RANK[o["min"]]
    root = C.review_dir()
    for w in health_warnings(root):
        print(paint(w, "31;1"), file=sys.stderr)
    paths = Q.agent_event_paths(root)
    rows = []
    for path, f in C.iter_findings():
        rid = str(f.get("request") or path.stem)
        if o["rid"] and rid != o["rid"]:
            continue
        if not o["rid"] and o["since"] > 0 and not C.finding_age_ok(f, path, timedelta(hours=o["since"])):
            continue
        items = []
        for it in f.get("items") or []:
            if not isinstance(it, dict) or C.SEVERITY_RANK.get(str(it.get("severity")), 0) < floor:
                continue
            iid = str(it.get("id"))
            try:
                C.check_ids(rid, iid)
                ack = ack_info(rid, iid, root, paths)
            except ValueError:
                ack = None
            status = Q.closure(ack["actor"] if ack else None, it.get("severity"))
            if o["unacked"] and ack is not None:
                continue
            if o["needs_human"] and not Q.needs_human(status, it):
                continue
            items.append({**it, "acked": ack is not None, "status": status, "ack": ack})
        rows.append((rid, f, items))
    if o["rid"] and not rows:
        print(f"judge-findings: no finding {o['rid']}", file=sys.stderr)
        return 2

    if o["json"]:
        print(json.dumps([{**{k: v for k, v in f.items() if k != "items"}, "items": items}
                          for _, f, items in rows], indent=2, ensure_ascii=False))
        return 0
    if o["rid"] or o["items"]:
        shown = 0
        for status, title in GROUPS:
            group = [(rid, f, it) for rid, f, items in rows for it in C.items_sorted(items) if it["status"] == status]
            if not group:
                continue
            print(paint(f"== {title} ({len(group)}) ==", STATUS_COLOR[status]))
            for rid, f, it in group:
                print(f"  {rid} {it.get('id')} {sev(it.get('severity'))} {it.get('rubric')} "
                      f"verdict={it.get('verdict')}  [{f.get('mode')} {f.get('judge')}]")
                print(f"     claim: {it.get('claim')}")
                print(f"     evidence: {it.get('evidence')}")
                print(f"     recommendation: {it.get('recommendation')}")
                if it.get("ack"):
                    print(describe_ack(it))
                shown += 1
            print()
        if o["rid"]:
            for _, f, _items in rows:
                for n in f.get("notes") or []:
                    print(f"note ({f.get('mode', '?')}): {n}")
        if not shown:
            print("(no items)")
        return 0
    if not rows:
        print("no findings")
        return 0
    for rid, f, items in rows:
        counts = {s: sum(1 for i in items if i.get("severity") == s) for s in ("high", "medium", "low")}
        by_status = {s: sum(1 for i in items if i["status"] == s) for s, _ in GROUPS}
        parts = " ".join(paint(f"{s[0].upper()}:{counts[s]}", SEV_COLOR[s] if counts[s] else "") for s in counts)
        st = " ".join(paint(f"{s}:{n}", STATUS_COLOR[s] if n and s != "closed" else "") for s, n in by_status.items())
        print(f"{rid:<44} {f.get('mode', '?'):<15} {parts}  {st}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
