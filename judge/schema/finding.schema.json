{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "judge/schema/finding.schema.json",
  "title": "judge finding",
  "description": "Written to $JUDGE_REVIEW_DIR/findings/<request>.json by the judge runner. Items with empty evidence are dropped before writing. See judge/CONTRACT.md.",
  "type": "object",
  "required": ["request", "judge", "created", "mode", "items"],
  "properties": {
    "request": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9]{1,6}-(plan|gate|completion|runaway)$"},
    "judge": {"type": "string", "minLength": 1},
    "created": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "mode": {"type": "string", "enum": ["frontier", "local", "frontier-claims"]},
    "notes": {"type": "array", "items": {"type": "string"}},
    "code_versions": {"type": "object", "description": "optional: judge code versions (lib/version.code_version) of the request writer, the collector that built the bundle and the runner that judged it; a mismatch is a note, never a failure", "properties": {"request": {"type": ["object", "null"], "properties": {"sha": {"type": ["string", "null"], "maxLength": 80, "description": "git tree id of judge/ (index), or the first line of judge/VERSION"}, "commit": {"type": ["string", "null"], "maxLength": 80}, "dirty": {"type": "boolean"}, "source": {"type": "string", "enum": ["git", "file", "unknown"]}}}, "collector": {"type": ["object", "null"], "properties": {"sha": {"type": ["string", "null"], "maxLength": 80, "description": "git tree id of judge/ (index), or the first line of judge/VERSION"}, "commit": {"type": ["string", "null"], "maxLength": 80}, "dirty": {"type": "boolean"}, "source": {"type": "string", "enum": ["git", "file", "unknown"]}}}, "runner": {"type": ["object", "null"], "properties": {"sha": {"type": ["string", "null"], "maxLength": 80, "description": "git tree id of judge/ (index), or the first line of judge/VERSION"}, "commit": {"type": ["string", "null"], "maxLength": 80}, "dirty": {"type": "boolean"}, "source": {"type": "string", "enum": ["git", "file", "unknown"]}}}}},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rubric", "severity", "claim", "evidence", "verdict", "recommendation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$"},
          "rubric": {"type": "string", "enum": ["R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8"]},
          "severity": {"type": "string", "enum": ["high", "medium", "low"]},
          "claim": {"type": "string"},
          "evidence": {"type": "string"},
          "verdict": {"type": "string", "enum": ["true", "false", "partial", "n/a", "defect"]},
          "recommendation": {"type": "string"},
          "failure_scenario": {"type": "string", "description": "R8 only: the concrete input or sequence of events and the wrong result"}
        }
      }
    }
  }
}
