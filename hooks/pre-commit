#!/usr/bin/env bash
# pre-commit: the hook is tools/deck-tools/pre-commit (deck-tools verify, then scripts/check-sanitized.sh on the
# staged and untracked files; blocks on a finding, exit 1, and on no real-value source, exit 2).
# Install: tools/deck-tools/deck-tools install-hooks, or git config core.hooksPath hooks (CONVENTIONS.md).
# Paths come from git, not from this file's location, so a symlink to this file serves every worktree.
root=$(git rev-parse --show-toplevel) || exit 1
if [[ -e $root/tools/deck-tools/pre-commit ]]; then exec "$root/tools/deck-tools/pre-commit" "$@"; fi
# A work tree from before tools/deck-tools/ existed: its own sanitizer only, fail closed.
"$root/scripts/check-sanitized.sh"
rc=$?
((rc == 0)) || echo "pre-commit: check-sanitized failed (exit $rc); commit blocked" >&2
exit "$rc"
