# Open WebUI environment -- contains secrets, root:root 600
WEBUI_URL=https://${SPARK_CHAT_HOST}
WEBUI_SECRET_KEY=CHANGEME
# .env is the source of truth: do not let DB-persisted config override env on restart
ENABLE_PERSISTENT_CONFIG=false

# --- Model backend (LiteLLM gateway) ---
ENABLE_OLLAMA_API=false
ENABLE_OPENAI_API=true
DEFAULT_MODELS=coder

# --- Auth ---
ENABLE_SIGNUP=false
ENABLE_LOGIN_FORM=true
DEFAULT_USER_ROLE=user

# --- OIDC via Pocket-ID ---
ENABLE_OAUTH_SIGNUP=true
OAUTH_PROVIDER_NAME=Pocket-ID
OPENID_PROVIDER_URL=https://${SPARK_ID_HOST}/.well-known/openid-configuration
OAUTH_CLIENT_ID=open-webui
OAUTH_CLIENT_SECRET=CHANGEME
OAUTH_SCOPES=openid email profile groups
OAUTH_CODE_CHALLENGE_METHOD=S256
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
OAUTH_USERNAME_CLAIM=preferred_username

# --- Telemetry off ---
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
ENABLE_VERSION_UPDATE_CHECK=false

# --- Misc ---
CORS_ALLOW_ORIGIN=https://${SPARK_CHAT_HOST}
ENABLE_EVALUATION_ARENA_MODELS=false

# --- Reverse proxy trust (uvicorn): only Covenant (edge reverse proxy over wg0) may set X-Forwarded-*
FORWARDED_ALLOW_IPS=${EDGE_WG_IP}
# Connections (index 0 = LiteLLM gateway, index 1 = Hermes agent on the workstation via libvirt bridge)
OPENAI_API_BASE_URLS=http://${BACKEND_WG_IP}:4000/v1;http://${HYPERVISOR_BRIDGE_IP}:${HERMES_GATEWAY_PORT}/v1
OPENAI_API_KEYS=CHANGEME
AIOHTTP_CLIENT_TIMEOUT=900
