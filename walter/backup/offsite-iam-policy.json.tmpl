{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ResticBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::${RESTIC_BUCKET}"
    },
    {
      "Sid": "ResticObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::${RESTIC_BUCKET}/*"
    }
  ]
}
