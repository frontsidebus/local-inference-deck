litellm_settings:
  # /srv/gateway/hooks/spark_hooks.py (mounted at /app): mid-conversation system/developer
  # messages -> user <system-reminder> text (Qwen templates reject/drop them otherwise)
  callbacks: ["spark_hooks.proxy_handler_instance", "prometheus"]
  # /metrics unauthenticated (owner-approved 2026-10-01): reachable only from Walter + Covenant (WALTER-PUBLISHED); nginx on api. does not expose it
  require_auth_for_metrics_endpoint: false
  drop_params: true
  request_timeout: 900
  num_retries: 0            # retries would trigger extra cold model loads in llama-swap
  telemetry: false
  check_provider_endpoint: true   # /v1/models lists real llama-swap IDs for local/* instead of OpenAI catalog names

router_settings:
  num_retries: 0
  timeout: 900

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
  database_url: os.environ/DATABASE_URL
  store_model_in_db: false
  trusted_proxy_ranges: ["${EDGE_WG_IP}/32"]   # Covenant edge proxy over wg0; XFF honoured only from this peer. use_x_forwarded_for stays off (it trusts XFF from any peer)
