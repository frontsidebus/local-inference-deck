# llama-swap v260 config for Walter -> /etc/llama-swap/config.yaml
# Each model is a llama-server container (image pinned by digest), bound to 127.0.0.1 only.
# Model IDs are the concrete model; aliases (coder, coder-fast, big, vision) are the stable names harnesses use.
# GPU0 and GPU1 are both PCIe Gen4 x8 on CPU root ports (x8/x8 bifurcation riser). Single-GPU models are
# pinned (-sm none). big splits by layer; hermes and vision use tensor split (see the notes above those entries).

healthCheckTimeout: 600        # generous: the slowest load (big, cold page cache) is about 20 s, disk-bound
logLevel: info
logToStdout: "proxy,http"
startPort: 10001
globalTTL: 0
sendLoadingState: true
includeAliasesInList: true
# No request/response captures: v260 keeps the last 5 MB of bodies in memory by default and serves them at
# /api/captures/{id} to any API-key holder (telemetry, monitoring). 0 turns capturing off. A test asserts it.
captureBuffer: 0

apiKeys:
  - "${env.LLAMA_SWAP_API_KEY}"

macros:
  "image": "ghcr.io/ggml-org/llama.cpp:server-cuda@sha256:7149a45c80596644320de1d565db1b3b8e70b22c66fed612e69b73f6b1e0d746"
  # build 11459 (qwen4exp fixes after 11277: #29751 decode +13-55 %, #29761 MTP, #29825 indexer memory, #29994 race).
  # flash ran on it until 2026-10-23 and moved to ${image-lab} for the MoE expert cache; no core model uses it now,
  # but the lab registry can still pick it (walter/models/lib/registry.py IMAGES).
  "image-next": "ghcr.io/ggml-org/llama.cpp:server-cuda@sha256:fff6185edd2fbc4093aa5970bf6db53ed11c283e3a1c52a3e244cf27047264f4"
  # build 11749, used by flash (the MoE expert cache: llama.cpp #29887 + #30112 multi-GPU + #30637 SLRU) and by lab
  # models that pick it (registry `image: image-lab`): Nemotron 3.5 Bolt / Super's pruned MoE layers have per-layer
  # expert counts, which load from llama.cpp PR #30520 (merged 2026-10-15) on; 11277 and 11459 refuse them
  # (check_tensor_dims). Measured 2026-10-20: Bolt 74B-A9B 24GB on GPU1, 21.2 GiB at 32K, ~87 t/s.
  "image-lab": "ghcr.io/ggml-org/llama.cpp:server-cuda-b11749@sha256:31b39eacce2bab5fde9286ec3980ed5548a3987644e94da0d0c2092f93313538"
  # spark-docker-run.sh waits for a same-named container (from a reload) to be gone, then execs docker run --name <id>
  # Hardened (walter/README.md "Model container hardening"; tests: walter/tests/test_llama_swap_config.py):
  #  - mounts ONLY ${MODELS_DIR}/gguf (read-only) at /models/gguf; never ${MODELS_DIR} itself, which holds backups/
  #  - non-root uid:gid 10010 (the image's default user is root), no capabilities, no-new-privileges, read-only
  #    root filesystem with a small /tmp tmpfs (HOME=/tmp for the CUDA JIT cache), at most 512 processes
  #  - network llama-net (bridge br-llama, created by deploy.sh): docker-user-rules.sh drops every new connection
  #    from it, so the container has no egress; llama-swap still reaches it through the loopback published port
  # The memory limit is per model: ${mem} (GPU-resident) or ${mem-moe} (experts in RAM); every cmd uses exactly one.
  "run": "/usr/local/sbin/spark-docker-run.sh ${MODEL_ID} --rm --init --label llama-swap=1 --runtime nvidia --network llama-net -p 127.0.0.1:${PORT}:8080 -v ${MODELS_DIR}/gguf:/models/gguf:ro --user 10010:10010 --cap-drop ALL --security-opt no-new-privileges --read-only --tmpfs /tmp:rw,nosuid,nodev,size=1g -e HOME=/tmp --pids-limit 512"
  # Memory caps (RAM + page cache charged to the container; clean model pages are reclaimed, not OOM-killed, at the
  # cap). GPU-resident models need a few GB (CPU token embeddings, prompt cache up to 8 GiB, buffers); 32g also keeps
  # most of a 39 GB GGUF in page cache for a warm reload. flash maps all ~47 GB of its experts plus the on-demand
  # n-gram table pages: 64g, which leaves ~16 GB of the 80 GiB VM for the gateway and the other stacks. The mapped
  # pages are clean, so at the cap the kernel drops cold ones and re-reads them from NVMe; the hot experts also sit in
  # the GPU expert cache, so decode rarely touches them (measured 2026-10-23, BENCHMARKS.md).
  # Swap equal to memory: no swapping of weights.
  "mem": "--memory 32g --memory-swap 32g"
  "mem-moe": "--memory 64g --memory-swap 64g"
  # common llama-server args: everything on GPU, fail loudly instead of auto-shrinking, one slot, q8_0 KV
  # Every model also gets `-n <N>` (output backstop): llama-server's default is -1 = generate until the
  # context is full. -n is only a DEFAULT for requests without max_tokens (a request that asks for more
  # still gets more), so the per-request clamp lives in the gateway (spark_hooks.py). Keep N equal to
  # model_info.max_tokens in litellm.yaml and MODEL_MAX_OUTPUT in spark_hooks.py.
  "common": "-a ${MODEL_ID} --fit off -ngl all -np 1 -fa on -ctk q8_0 -ctv q8_0 --jinja --metrics --no-webui"
  # docker args for tensor split (-sm tensor): NCCL allreduce has no P2P between GeForce cards under vfio, so it
  # goes through host shared memory; Docker's default 64 MB /dev/shm crashes at the first allreduce
  # ("unhandled system error ... ncclGroupEnd()"). Only the tensor-split models use it; ${run} is unchanged.
  "tp": "--shm-size 2g"
  # Project Maya (walter/maya/README.md): built on Walter's side from pinned sources, so a local tag, not a digest.
  # deploy.sh checks the tag is present. Bump the tag with walter/maya/Dockerfile.
  "maya-image": "walter-maya:8d9a9b5-2"
  # rm -f is synchronous (stop + --rm removes asynchronously, so a reload's docker run could hit a name conflict)
  "stop": "docker rm -f ${MODEL_ID}"

models:
  "qwen3.8-27b":
    name: "Qwen3.8 27B (GPU0)"
    aliases: ["coder"]
    cmd: |
      ${run} ${mem} --gpus "\"device=0\"" ${image}
      -m /models/gguf/qwen3.8-27b/Qwen3.8-27B-UD-Q4_K_XL.gguf
      ${common} -c 131072 -n 32768 -sm none --spec-type draft-mtp --spec-draft-n-max 2
      --temp 0.6 --top-p 0.95 --top-k 20 --min-p 0
    cmdStop: ${stop}
    proxy: http://127.0.0.1:${PORT}
    unloadTimeout: 30
    capabilities: { in: [text], out: [text], tools: true, context: 131072 }

  # --presence-penalty 1.5 is a default: a request's own presence_penalty overrides it (0 turns it off). Measured
  # 2026-10-05 (BENCHMARKS.md): thinking-mode code runaways (reasoning past 12288 tokens) 5/20 -> 1/20, tests passed
  # 14/20 -> 18/20; json_schema, the judge's json_object and digest curation unchanged. llama-server applies it only
  # to the last 64 tokens (--repeat-last-n). coder stays at 0 (no measured benefit); big was not measured.
  "qwen3.6-35b-a3b":
    name: "Qwen3.6 35B-A3B (GPU1)"
    aliases: ["coder-fast"]
    cmd: |
      ${run} ${mem} --gpus "\"device=1\"" ${image}
      -m /models/gguf/qwen3.6-35b-a3b/Qwen3.6-35B-A3B-UD-IQ4_NL_XL.gguf
      ${common} -c 131072 -n 32768 -sm none
      --temp 0.6 --top-p 0.95 --top-k 20 --min-p 0 --presence-penalty 1.5
    cmdStop: ${stop}
    proxy: http://127.0.0.1:${PORT}
    unloadTimeout: 30
    capabilities: { in: [text], out: [text], tools: true, context: 131072 }

  "qwen3-coder-next":
    name: "Qwen3-Coder-Next 80B-A3B (GPU0+GPU1)"
    aliases: ["big"]
    cmd: |
      ${run} ${mem} --gpus "\"device=0,1\"" ${image}
      -m /models/gguf/qwen3-coder-next/Qwen3-Coder-Next-UD-IQ4_NL.gguf
      ${common} -c 131072 -n 32768 -sm layer -ts 1,1
      --temp 1.0 --top-p 0.95 --top-k 40 --min-p 0.01
    cmdStop: ${stop}
    proxy: http://127.0.0.1:${PORT}
    unloadTimeout: 30
    ttl: 1800
    capabilities: { in: [text], out: [text], tools: true, context: 131072 }

  # Tensor split (EXPERIMENTAL in llama.cpp), measured 2026-10-05 on build 11277, Gen4 x8 + x8, vs -sm layer -ts 1,1:
  #   decode +39 % (512-token prompt), +42 % (8k), +47 % (32k); image prompt 39.9 -> 52-55 t/s;
  #   prompt processing +17 % at 512 tokens but -20 % at 8k and -22 % at 32k; VRAM and load time unchanged.
  # Fallback to layer split: drop "${tp} " and replace "-sm tensor" with "-sm layer -ts 1,1".
  "gemma-4-31b":
    name: "Gemma 4 31B QAT + vision (GPU0+GPU1)"
    aliases: ["vision"]
    cmd: |
      ${run} ${mem} ${tp} --gpus "\"device=0,1\"" ${image}
      -m /models/gguf/gemma-4-31b-qat/gemma-4-31B-it-qat-UD-Q4_K_XL.gguf
      --mmproj /models/gguf/gemma-4-31b-qat/mmproj-BF16.gguf
      ${common} -c 131072 -n 16384 -sm tensor --ctx-checkpoints 8
      --temp 1.0 --top-p 0.95 --top-k 64
    cmdStop: ${stop}
    proxy: http://127.0.0.1:${PORT}
    unloadTimeout: 30
    ttl: 1800
    capabilities: { in: [text, image], out: [text], tools: true, context: 131072 }

  # Tensor split (EXPERIMENTAL in llama.cpp), measured 2026-10-05 on build 11277, Gen4 x8 + x8, vs -sm layer -ts 1,1:
  #   decode +47 % (512-token prompt), +53 % (8k), +63 % (32k), +67 % (60k);
  #   prompt processing +16 % at 512 tokens but -23 % at 8k, -16 % at 32k, -12 % at 60k; VRAM and load time unchanged.
  # Fallback to layer split: drop "${tp} " and replace "-sm tensor" with "-sm layer -ts 1,1".
  # big stays on layer split: tensor gave -7 %..+8 % decode and -15 % prompt processing on its 3B-active MoE.
  "hermes-4.3-36b":
    name: "Hermes 4.3 36B (GPU0+GPU1)"
    aliases: ["hermes"]
    cmd: |
      ${run} ${mem} ${tp} --gpus "\"device=0,1\"" ${image}
      -m /models/gguf/hermes-4.3-36b/hermes-4_3_36b-Q4_K_M.gguf
      ${common} -c 65536 -n 16384 -sm tensor
      --temp 0.6 --top-p 0.95 --top-k 20
    cmdStop: ${stop}
    proxy: http://127.0.0.1:${PORT}
    unloadTimeout: 30
    ttl: 1800
    capabilities: { in: [text], out: [text], tools: true, context: 65536 }

  # EXPERIMENTAL (2026-10-08): Qwen3.8-Flash-Next, 125B MoE (6B active, 512 experts, 48 layers: 12x [3 Gated DeltaNet +
  # 1 sparse attention]), ISTA-DASLab GSQ-RCO IQ3_S (model-card task average 93.26 vs 93.12 BF16). Being evaluated
  # (evals/plans) before any routing decision; hidden in Open WebUI until then.
  # Placement: layer split over both GPUs; the 28.8 GB n-gram table (per_layer_token_embd, shard 2) stays on the CPU
  # and is read from disk on demand (-lm mmap -lzm on). ALL routed experts (~47 GB) live in RAM (-ot ...=CPU) and
  # llama.cpp's MoE expert cache (--moe-cache-mib, a TOTAL split over the GPUs by -ts: 2 x 11 GiB) runs the recently
  # used ones on the GPU, uploading only the misses (hit rate ~93 % in decode). -b/-ub 2048 uploads each missed expert
  # once per 2048 prompt tokens instead of per 512. MTP: unsloth's self-contained Q8_0 head on GPU1, 2 drafted tokens.
  # Measured 2026-10-23 (BENCHMARKS.md): decode 57-60 t/s and prompt 333-407 t/s, against 40-45 / 260-280 for the old
  # placement (16 CPU expert layers, no cache). VRAM after load ~16.7 / 22.3 of 24.6 GB; GPU1 (MTP head) is the
  # tightest card; it peaked ~180 MiB above that at ~127K tokens, where the old placement ran out of memory on GPU1
  # at ~106K. A bigger cache at the default -ub 512 (2 x 14.5 GiB) decodes faster (66-79) but prompts at 155-179.
  # Small caches lose: 1.5 GiB per GPU with 20 CPU layers hit 60 % and decoded slower than no cache (PCIe x8).
  # Fallback (old placement, ${image-next}): -ot "per_layer_token_embd=CPU,blk\.([0-5]|2[4-9]|3[0-3])\.ffn_.*_exps\.=CPU",
  # no --moe-cache-mib / -b / -ub. The "shared" MTP head does not load on mainline (it needs tensor borrowing).
  "qwen3.8-flash-next":
    name: "Qwen3.8-Flash-Next 125B-A6B IQ3_S (GPU0+GPU1+CPU experts, experimental)"
    aliases: ["flash"]
    cmd: |
      ${run} ${mem-moe} --gpus "\"device=0,1\"" ${image-lab}
      -m /models/gguf/qwen3.8-flash-next/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf
      ${common} -c 131072 -n 32768 -sm layer -ts 1,1 -lm mmap -lzm on -b 2048 -ub 2048
      -ot "per_layer_token_embd=CPU,blk\.[0-9]+\.ffn_.*_exps\.=CPU" --moe-cache-mib 22000
      -md /models/gguf/qwen3.8-flash-next/mtp-Qwen3.8-Flash-Next-Q8_0.gguf
      --spec-type draft-mtp --spec-draft-n-max 2 -devd CUDA1 -ngld 99
      --temp 0.6 --top-p 0.95 --top-k 20 --min-p 0
    cmdStop: ${stop}
    proxy: http://127.0.0.1:${PORT}
    unloadTimeout: 30
    ttl: 1800
    capabilities: { in: [text], out: [text], tools: true, context: 131072 }

  # LAB (2026-10-20): GLM-5.3-Flash (321B MoE, ~18B active) on the Project Maya engine, not llama-server
  # (walter/maya/README.md). Maya-S24 quant (94.7 GB): 83 % of the routed experts in VRAM, the rest pinned in RAM
  # (MAYA_GLM_RAM_GB=46 in the run config, under the 64g cap), nothing read from disk. Decode ~39 t/s, prompt
  # 375 t/s at 1.7k and 916 t/s at 9.4k tokens (BENCHMARKS.md, 2026-10-20). Load ~35 s warm.
  # lab-: the gateway's lab guard (spark_hooks.py) refuses it to keys without metadata.lab; unlisted; no tools.
  # Extra mounts: the packs and the engine log (rw, uid 10010) and the root-owned run config (ro). The image's
  # entrypoint (lab_entry.py) answers only /health, /v1/models, /models, /props, /slots, POST /v1/chat/completions
  # and /v1/messages: llama-swap's /upstream/<id>/ would otherwise reach Maya's admin routes. No API key: like the
  # llama-server containers it listens on 127.0.0.1 only, and llama-swap holds the key.
  "lab-glm-5.3-flash":
    name: "GLM-5.3-Flash Maya-S24 (Project Maya, GPU0+GPU1+RAM experts, lab)"
    cmd: |
      ${run} ${mem-moe} --gpus "\"device=0,1\""
      -v ${MODELS_DIR}/maya-data:/data -v /etc/maya/glm-5.3-flash.json:/cfg/glm.json:ro
      ${maya-image} --config /cfg/glm.json --port 8080
    cmdStop: ${stop}
    proxy: http://127.0.0.1:${PORT}
    unloadTimeout: 30
    ttl: 1800
    unlisted: true
    capabilities: { in: [text], out: [text], tools: false, context: 32768 }

routing:
  router:
    use: matrix
    settings:
      matrix:
        vars:
          c: qwen3.8-27b
          f: qwen3.6-35b-a3b
          b: qwen3-coder-next
          v: gemma-4-31b
          h: hermes-4.3-36b
          x: qwen3.8-flash-next
          m: lab-glm-5.3-flash
        evict_costs:
          b: 5     # ~40 GB read from disk: about 20 s when the page cache is cold, 7 s when warm
          x: 5     # ~55 GB of weights to read (the n-gram table is read on demand); slower than big
          m: 5     # ~90 GB of experts into VRAM and pinned RAM: ~35 s warm
        sets:
          coding: "c & f"   # one per GPU, the default working pair
          big: "b"
          vision: "v"
          hermes: "h"
          flash: "x"
          maya: "m"

hooks:
  on_startup:
    preload: ["qwen3.8-27b", "qwen3.6-35b-a3b"]

# Reloads are safe: tested 2026-10-01, both models come back via the startup preload (spark-docker-run.sh).
