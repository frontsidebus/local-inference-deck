# llama-swap v260 config for Walter -> /etc/llama-swap/config.yaml
# Each model is a llama-server container (image pinned by digest), bound to 127.0.0.1 only.
# Model IDs are the concrete model; aliases (coder, coder-fast, big, vision) are the stable names harnesses use.
# GPU0 and GPU1 are both PCIe Gen4 x8 on CPU root ports (x8/x8 bifurcation riser). Single-GPU models are
# pinned (-sm none). big splits by layer; hermes and vision use tensor split (see the notes above those entries).

healthCheckTimeout: 600        # generous: the slowest load (big, cold page cache) is about 20 s, disk-bound
logLevel: info
logToStdout: "proxy,http"
startPort: 10001
globalTTL: 0
sendLoadingState: true
includeAliasesInList: true

apiKeys:
  - "${env.LLAMA_SWAP_API_KEY}"

macros:
  "image": "ghcr.io/ggml-org/llama.cpp:server-cuda@sha256:7149a45c80596644320de1d565db1b3b8e70b22c66fed612e69b73f6b1e0d746"
  # build 11459, used ONLY by the experimental flash entry (qwen4exp needs fixes after 11277: #29751 decode +13-55 %,
  # #29761 MTP, #29825 indexer memory, #29994 race). Every other model stays on ${image}.
  "image-next": "ghcr.io/ggml-org/llama.cpp:server-cuda@sha256:fff6185edd2fbc4093aa5970bf6db53ed11c283e3a1c52a3e244cf27047264f4"
  # spark-docker-run.sh waits for a same-named container (from a reload) to be gone, then execs docker run --name <id>
  "run": "/usr/local/sbin/spark-docker-run.sh ${MODEL_ID} --rm --init --label llama-swap=1 --runtime nvidia -p 127.0.0.1:${PORT}:8080 -v ${MODELS_DIR}:/models:ro"
  # common llama-server args: everything on GPU, fail loudly instead of auto-shrinking, one slot, q8_0 KV
  # Every model also gets `-n <N>` (output backstop): llama-server's default is -1 = generate until the
  # context is full. -n is only a DEFAULT for requests without max_tokens (a request that asks for more
  # still gets more), so the per-request clamp lives in the gateway (spark_hooks.py). Keep N equal to
  # model_info.max_tokens in litellm.yaml and MODEL_MAX_OUTPUT in spark_hooks.py.
  "common": "-a ${MODEL_ID} --fit off -ngl all -np 1 -fa on -ctk q8_0 -ctv q8_0 --jinja --metrics --no-webui"
  # docker args for tensor split (-sm tensor): NCCL allreduce has no P2P between GeForce cards under vfio, so it
  # goes through host shared memory; Docker's default 64 MB /dev/shm crashes at the first allreduce
  # ("unhandled system error ... ncclGroupEnd()"). Only the tensor-split models use it; ${run} is unchanged.
  "tp": "--shm-size 2g"
  # rm -f is synchronous (stop + --rm removes asynchronously, so a reload's docker run could hit a name conflict)
  "stop": "docker rm -f ${MODEL_ID}"

models:
  "qwen3.8-27b":
    name: "Qwen3.8 27B (GPU0)"
    aliases: ["coder"]
    cmd: |
      ${run} --gpus "\"device=0\"" ${image}
      -m /models/gguf/qwen3.8-27b/Qwen3.8-27B-UD-Q4_K_XL.gguf
      ${common} -c 131072 -n 32768 -sm none --spec-type draft-mtp --spec-draft-n-max 2
      --temp 0.6 --top-p 0.95 --top-k 20 --min-p 0
    cmdStop: ${stop}
    proxy: http://127.0.0.1:${PORT}
    unloadTimeout: 30
    capabilities: { in: [text], out: [text], tools: true, context: 131072 }

  # --presence-penalty 1.5 is a default: a request's own presence_penalty overrides it (0 turns it off). Measured
  # 2026-10-05 (BENCHMARKS.md): thinking-mode code runaways (reasoning past 12288 tokens) 5/20 -> 1/20, tests passed
  # 14/20 -> 18/20; json_schema, the judge's json_object and digest curation unchanged. llama-server applies it only
  # to the last 64 tokens (--repeat-last-n). coder stays at 0 (no measured benefit); big was not measured.
  "qwen3.6-35b-a3b":
    name: "Qwen3.6 35B-A3B (GPU1)"
    aliases: ["coder-fast"]
    cmd: |
      ${run} --gpus "\"device=1\"" ${image}
      -m /models/gguf/qwen3.6-35b-a3b/Qwen3.6-35B-A3B-UD-IQ4_NL_XL.gguf
      ${common} -c 131072 -n 32768 -sm none
      --temp 0.6 --top-p 0.95 --top-k 20 --min-p 0 --presence-penalty 1.5
    cmdStop: ${stop}
    proxy: http://127.0.0.1:${PORT}
    unloadTimeout: 30
    capabilities: { in: [text], out: [text], tools: true, context: 131072 }

  "qwen3-coder-next":
    name: "Qwen3-Coder-Next 80B-A3B (GPU0+GPU1)"
    aliases: ["big"]
    cmd: |
      ${run} --gpus "\"device=0,1\"" ${image}
      -m /models/gguf/qwen3-coder-next/Qwen3-Coder-Next-UD-IQ4_NL.gguf
      ${common} -c 131072 -n 32768 -sm layer -ts 1,1
      --temp 1.0 --top-p 0.95 --top-k 40 --min-p 0.01
    cmdStop: ${stop}
    proxy: http://127.0.0.1:${PORT}
    unloadTimeout: 30
    ttl: 1800
    capabilities: { in: [text], out: [text], tools: true, context: 131072 }

  # Tensor split (EXPERIMENTAL in llama.cpp), measured 2026-10-05 on build 11277, Gen4 x8 + x8, vs -sm layer -ts 1,1:
  #   decode +39 % (512-token prompt), +42 % (8k), +47 % (32k); image prompt 39.9 -> 52-55 t/s;
  #   prompt processing +17 % at 512 tokens but -20 % at 8k and -22 % at 32k; VRAM and load time unchanged.
  # Fallback to layer split: drop "${tp} " and replace "-sm tensor" with "-sm layer -ts 1,1".
  "gemma-4-31b":
    name: "Gemma 4 31B QAT + vision (GPU0+GPU1)"
    aliases: ["vision"]
    cmd: |
      ${run} ${tp} --gpus "\"device=0,1\"" ${image}
      -m /models/gguf/gemma-4-31b-qat/gemma-4-31B-it-qat-UD-Q4_K_XL.gguf
      --mmproj /models/gguf/gemma-4-31b-qat/mmproj-BF16.gguf
      ${common} -c 131072 -n 16384 -sm tensor --ctx-checkpoints 8
      --temp 1.0 --top-p 0.95 --top-k 64
    cmdStop: ${stop}
    proxy: http://127.0.0.1:${PORT}
    unloadTimeout: 30
    ttl: 1800
    capabilities: { in: [text, image], out: [text], tools: true, context: 131072 }

  # Tensor split (EXPERIMENTAL in llama.cpp), measured 2026-10-05 on build 11277, Gen4 x8 + x8, vs -sm layer -ts 1,1:
  #   decode +47 % (512-token prompt), +53 % (8k), +63 % (32k), +67 % (60k);
  #   prompt processing +16 % at 512 tokens but -23 % at 8k, -16 % at 32k, -12 % at 60k; VRAM and load time unchanged.
  # Fallback to layer split: drop "${tp} " and replace "-sm tensor" with "-sm layer -ts 1,1".
  # big stays on layer split: tensor gave -7 %..+8 % decode and -15 % prompt processing on its 3B-active MoE.
  "hermes-4.3-36b":
    name: "Hermes 4.3 36B (GPU0+GPU1)"
    aliases: ["hermes"]
    cmd: |
      ${run} ${tp} --gpus "\"device=0,1\"" ${image}
      -m /models/gguf/hermes-4.3-36b/hermes-4_3_36b-Q4_K_M.gguf
      ${common} -c 65536 -n 16384 -sm tensor
      --temp 0.6 --top-p 0.95 --top-k 20
    cmdStop: ${stop}
    proxy: http://127.0.0.1:${PORT}
    unloadTimeout: 30
    ttl: 1800
    capabilities: { in: [text], out: [text], tools: true, context: 65536 }

  # EXPERIMENTAL (2026-10-08): Qwen3.8-Flash-Next, 125B MoE (6B active, 512 experts, 48 layers: 12x [3 Gated DeltaNet +
  # 1 sparse attention]), ISTA-DASLab GSQ-RCO IQ3_S (model-card task average 93.26 vs 93.12 BF16). Being evaluated
  # (evals/plans) before any routing decision; hidden in Open WebUI until then.
  # Placement: layer split over both GPUs; the 28.8 GB n-gram table (per_layer_token_embd, shard 2) stays on the CPU
  # and is read from disk on demand (-lm mmap -lzm on); the routed experts of 16 layers (blk 0-5 on GPU0's half,
  # blk 24-33 on GPU1's) run on the CPU from RAM (~17 GB), leaving GPU1 room for the MTP draft head.
  # MTP (unsloth's self-contained Q8_0 head on GPU1, 2 drafted tokens): decode 45-47 t/s vs 38-40 without it, prompt
  # processing ~295 vs ~390 t/s (BENCHMARKS.md, 2026-10-09). The "shared" head does not load on mainline (it needs
  # tensor borrowing). VRAM after load ~21.5 / 23.5 of 24.6 GB. KV is small: 12 attention layers (~1.7 GB at 128K).
  # Fallback without MTP: drop the -md/--spec-type/-devd/-ngld args and use blk\.([0-4]|2[4-9])\. (11 CPU layers).
  "qwen3.8-flash-next":
    name: "Qwen3.8-Flash-Next 125B-A6B IQ3_S (GPU0+GPU1+CPU experts, experimental)"
    aliases: ["flash"]
    cmd: |
      ${run} --gpus "\"device=0,1\"" ${image-next}
      -m /models/gguf/qwen3.8-flash-next/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf
      ${common} -c 131072 -n 32768 -sm layer -ts 1,1 -lm mmap -lzm on
      -ot "per_layer_token_embd=CPU,blk\.([0-5]|2[4-9]|3[0-3])\.ffn_.*_exps\.=CPU"
      -md /models/gguf/qwen3.8-flash-next/mtp-Qwen3.8-Flash-Next-Q8_0.gguf
      --spec-type draft-mtp --spec-draft-n-max 2 -devd CUDA1 -ngld 99
      --temp 0.6 --top-p 0.95 --top-k 20 --min-p 0
    cmdStop: ${stop}
    proxy: http://127.0.0.1:${PORT}
    unloadTimeout: 30
    ttl: 1800
    capabilities: { in: [text], out: [text], tools: true, context: 131072 }

routing:
  router:
    use: matrix
    settings:
      matrix:
        vars:
          c: qwen3.8-27b
          f: qwen3.6-35b-a3b
          b: qwen3-coder-next
          v: gemma-4-31b
          h: hermes-4.3-36b
          x: qwen3.8-flash-next
        evict_costs:
          b: 5     # ~40 GB read from disk: about 20 s when the page cache is cold, 7 s when warm
          x: 5     # ~55 GB of weights to read (the n-gram table is read on demand); slower than big
        sets:
          coding: "c & f"   # one per GPU, the default working pair
          big: "b"
          vision: "v"
          hermes: "h"
          flash: "x"

hooks:
  on_startup:
    preload: ["qwen3.8-27b", "qwen3.6-35b-a3b"]

# Reloads are safe: tested 2026-10-01, both models come back via the startup preload (spark-docker-run.sh).
