WARNINGS = []


def warn(msg):
    WARNINGS.append(msg)
    print("warning: " + msg, file=sys.stderr)


def run(cmd, timeout=60):
    """Run a command, return (rc, stdout). Never raises."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout,
                           env=dict(os.environ, LANG="C", LC_ALL="C"))
        return p.returncode, p.stdout
    except Exception as e:  # noqa: BLE001
        return 127, "%s: %s" % (type(e).__name__, e)


def now():
    return dt.datetime.now(dt.timezone.utc)


def parse_iso(s):
    if not s:
        return None
    try:
        return dt.datetime.fromisoformat(s.replace("Z", "+00:00"))
    except ValueError:
        return None


def md_escape(s):
    return str(s).replace("|", "\\|").replace("\n", " ")


# --------------------------------------------------------------------------
# version handling (semver-ish, PEP440-ish, llama.cpp build numbers)
# --------------------------------------------------------------------------
_PRE_RANK = {"dev": -1, "alpha": 0, "a": 0, "beta": 1, "b": 1, "pre": 2,
             "preview": 2, "rc": 2, "c": 2}
_VER_RE = re.compile(
    r"^(\d+(?:\.\d+)*)"
    r"(?:[-.]?(?:stable|final|release|ga))?"
    r"(?:[-.]?(dev|alpha|beta|preview|pre|rc|a|b|c)[-.]?(\d*))?"
    r"(?:\+[\w.]+)?$", re.I)


class Ver:
    """Comparable version. kind 'build' (bNNNN) never compares to 'semver'."""

    def __init__(self, kind, key, text):
        self.kind, self.key, self.text = kind, key, text

    def _chk(self, o):
        if self.kind != o.kind:
            raise TypeError("incomparable versions %s / %s" % (self.text, o.text))

    def __lt__(self, o): self._chk(o); return self.key < o.key
    def __le__(self, o): self._chk(o); return self.key <= o.key
    def __gt__(self, o): self._chk(o); return self.key > o.key
    def __ge__(self, o): self._chk(o); return self.key >= o.key
    def __eq__(self, o): return isinstance(o, Ver) and self.kind == o.kind and self.key == o.key
    def __hash__(self): return hash((self.kind, self.key))
    def __repr__(self): return self.text

    @property
    def series(self):
        return self.key[0][:2] if self.kind == "semver" else None


def parse_ver(s):
    """'v1.2.3', 'v.2.8.0', '1.83.10-stable', '1.104.0rc1', 'b8145', 'v260'."""
    if s is None:
        return None
    t = s.strip().strip("'\"")
    t = re.sub(r"^[=<>!~^ ]+", "", t).strip()
    t = re.sub(r"^v\.?", "", t, flags=re.I)
    m = re.match(r"^b(\d+)$", t, re.I)
    if m:
        return Ver("build", (int(m.group(1)),), s.strip())
    m = _VER_RE.match(t)
    if not m:
        return None
    nums = tuple(int(x) for x in m.group(1).split("."))
    nums = (nums + (0, 0, 0, 0))[:4]
    if m.group(2):
        pre = (_PRE_RANK[m.group(2).lower()], int(m.group(3) or 0))
    else:
        pre = (9, 0)  # final release sorts after any pre-release
    return Ver("semver", (nums, pre), s.strip())


def _cmp(cur, op, v):
    return {"<": cur < v, "<=": cur <= v, ">": cur > v, ">=": cur >= v,
            "=": cur == v, "==": cur == v, "!=": not cur == v}[op]


def in_range(cur, rng):
    """True/False if cur is inside the advisory range, None if unparseable."""
    if not rng or not rng.strip():
        return None
    norm = re.sub(r"\s*(;|\|\||\bor\b)\s*", "||", rng, flags=re.I)
    norm = re.sub(r"\s+and\s+", " ", norm, flags=re.I)
    alts = []
    for alt in norm.split("||"):
        parts = [p.strip() for p in alt.split(",") if p.strip()]
        nops = [len(re.findall(r"[<>]=?|==|!=", p)) for p in parts]
        # GitHub style '>= 1.0, < 2.0' is AND. Comma-separated exact versions
        # ('3.10.0, 3.11.0') or comma-separated complete ranges
        # ('>= 2.24.1 < 2.37.4, >=2.38.0 < 2.40.4') are OR.
        if len(parts) > 1 and (all(n == 0 for n in nops) or any(n >= 2 for n in nops)):
            alts.extend(parts)
        else:
            alts.append(alt)
    try:
        results = []
        for alt in alts:
            alt = alt.strip()
            m = re.match(r"^(\S+)\s+-\s+(\S+)$", alt)  # 'v1.11.0 - v2.9.0'
            if m:
                lo, hi = parse_ver(m.group(1)), parse_ver(m.group(2))
                if not lo or not hi:
                    return None
                results.append(lo <= cur <= hi)
                continue
            ok = True
            for part in [p for p in re.split(r",|\s+(?=[<>=!])", alt) if p.strip()]:
                pm = re.match(r"^\s*(>=|<=|==|!=|>|<|=)?\s*(.+?)\s*$", part)
                op, v = pm.group(1) or "=", parse_ver(pm.group(2))
                if v is None:
                    return None
                ok = ok and _cmp(cur, op, v)
            results.append(ok)
        return any(results)
    except TypeError:
        return None


def lower_bound_only(rng):
    """'>= 8.1' style range with no upper bound."""
    ops = re.findall(r"[<>]=?", rng or "")
    return bool(ops) and all(o.startswith(">") for o in ops) and " - " not in rng


def patched_list(s):
    if not s:
        return []
    out = []
    for p in re.split(r",|;|\s+and\s+|\s+or\s+", s, flags=re.I):
        v = parse_ver(p)
        if v is not None:
            out.append(v)
    return out


def is_patched(cur, plist):
    """cur >= a patched version in the same major.minor series (backports),
    or >= the highest patched version. None if no usable data."""
    plist = [p for p in plist if p.kind == cur.kind]
    if not plist:
        return None
    if cur >= max(plist):
        return True
    for p in plist:
        if p.series is not None and p.series == cur.series and cur >= p:
            return True
    return False


def evaluate_advisory(adv, cur, cur_date_fn):
    """-> (verdict, note). verdict in AFFECTED / not affected / CHECK MANUALLY /
    likely not affected (manual)."""
    vulns = adv.get("vulnerabilities") or []
    verdicts, notes = [], []
    cur_date = None
    for v in vulns:
        pkg = v.get("package") or {}
        eco = (pkg.get("ecosystem") or "").strip().lower()
        rng = v.get("vulnerable_version_range") or ""
        pat = v.get("patched_versions") or ""
        r = in_range(cur, rng) if cur else None
        p = is_patched(cur, patched_list(pat)) if cur else None
        if r is False:
            verdicts.append("no")
        elif r is True:
            if p is True:
                verdicts.append("no")
                notes.append("range '%s' includes current but patched '%s' <= current"
                             % (rng, pat))
            elif p is None and lower_bound_only(rng):
                # open-ended range and no fixed version listed: either still
                # unfixed (recent) or incomplete advisory data (old)
                pub = parse_iso(adv.get("published_at"))
                cur_date = cur_date_fn()
                if pub and cur_date and pub < cur_date:
                    verdicts.append("manual-old")
                    notes.append("open-ended range '%s', no patched version listed; "
                                 "advisory predates current release" % rng)
                elif not cur_date:
                    verdicts.append("manual")
                    notes.append("open-ended range '%s', no patched version listed" % rng)
                else:
                    verdicts.append("yes")
                    notes.append("open-ended range '%s', no patched version listed" % rng)
            else:
                verdicts.append("yes")
        else:  # range unusable
            if p is not None:
                verdicts.append("no" if p else "yes")
                notes.append("range '%s' unparseable; judged by patched '%s'" % (rng, pat))
            else:
                verdicts.append("manual")
                notes.append("unparseable range '%s' / patched '%s'" % (rng, pat))
        if eco in ("", "other") and verdicts[-1] != "manual":
            notes.append("ecosystem '%s' (non-standard); version-compared" % (eco or "none"))
    if not vulns:
        verdicts.append("manual")
        notes.append("no version data")
    if "yes" in verdicts:
        return "AFFECTED", "; ".join(notes)
    if "manual-old" in verdicts:
        return "likely not affected (manual)", "; ".join(notes)
    if "manual" in verdicts and "no" not in verdicts:
        pub = parse_iso(adv.get("published_at"))
        cur_date = cur_date_fn()
        if pub and cur_date and pub > cur_date:
            return "CHECK MANUALLY", "; ".join(notes + ["published after current release"])
        if pub and cur_date:
            return "likely not affected (manual)", "; ".join(
                notes + ["published before current release date"])
        return "CHECK MANUALLY", "; ".join(notes + ["no release date to compare"])
    return "not affected", "; ".join(notes)


# --------------------------------------------------------------------------
# HTTP with ETag cache + backoff
# --------------------------------------------------------------------------
class RateLimited(Exception):
    pass


class Http:
    def __init__(self, token=None):
        self.token = token
        self.gh_exhausted = False
        self.gh_calls = 0
        self.gh_remaining = None
        self.stale = set()
        os.makedirs(CACHE_DIR, mode=0o700, exist_ok=True)

    def _cache_path(self, url):
        return os.path.join(CACHE_DIR, hashlib.sha256(url.encode()).hexdigest() + ".json")

    def github(self, path, params=None):
        """GET api.github.com JSON; follows Link rel=next for lists.
        Raises RateLimited / RuntimeError."""
        url = "https://api.github.com" + path
        if params:
            url += "?" + urllib.parse.urlencode(params)
        out, first = None, True
        while url:
            data, headers = self._gh_get(url)
            if first and not isinstance(data, list):
                return data
            first = False
            out = (out or []) + list(data)
            m = re.search(r'<([^>]+)>;\s*rel="next"', headers.get("Link", "") or "")
            url = m.group(1) if m else None
        return out

    def _gh_get(self, url):
        cpath = self._cache_path(url)
        cached = None
        try:
            with open(cpath) as f:
                cached = json.load(f)
        except (OSError, ValueError):
            pass
        try:
            return self._gh_fetch(url, cpath, cached)
        except RateLimited as e:
            if cached:
                age = (time.time() - os.path.getmtime(cpath)) / 86400
                self.stale.add("%s (rate limited; cached copy %.1f d old)" % (
                    url.split("?")[0].replace("https://api.github.com/repos/", ""), age))
                return cached["data"], {"Link": cached.get("link", "")}
            raise

    def _gh_fetch(self, url, cpath, cached):
        if self.gh_exhausted:
            raise RateLimited("GitHub rate limit exhausted earlier in this run")
        hdrs = {"Accept": "application/vnd.github+json", "User-Agent": UA,
                "X-GitHub-Api-Version": "2022-11-28"}
        if self.token:
            hdrs["Authorization"] = "Bearer " + self.token
        if cached and cached.get("etag"):
            hdrs["If-None-Match"] = cached["etag"]
        delay = 2
        for attempt in range(4):
            req = urllib.request.Request(url, headers=hdrs)
            self.gh_calls += 1
            try:
                with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as r:
                    body = r.read()
                    self.gh_remaining = r.headers.get("X-RateLimit-Remaining", self.gh_remaining)
                    data = json.loads(body)
                    link = r.headers.get("Link", "")
                    try:
                        with open(cpath + ".tmp", "w") as f:
                            json.dump({"etag": r.headers.get("ETag"), "link": link,
                                       "data": data}, f)
                        os.replace(cpath + ".tmp", cpath)
                    except OSError:
                        pass
                    return data, {"Link": link}
            except urllib.error.HTTPError as e:
                self.gh_remaining = e.headers.get("X-RateLimit-Remaining", self.gh_remaining)
                if e.code == 304 and cached:
                    return cached["data"], {"Link": cached.get("link", "")}
                if e.code in (403, 429):
                    ra = e.headers.get("Retry-After")
                    rem = e.headers.get("X-RateLimit-Remaining")
                    reset = e.headers.get("X-RateLimit-Reset")
                    if ra and int(ra) <= 60 and attempt < 3:
                        time.sleep(int(ra) + 1)
                        continue
                    if rem == "0":
                        wait = int(reset) - int(time.time()) if reset else 9999
                        if 0 < wait <= 60 and attempt < 3:
                            time.sleep(wait + 1)
                            continue
                        self.gh_exhausted = True
                        when = (dt.datetime.fromtimestamp(int(reset), dt.timezone.utc)
                                .strftime("%H:%M UTC") if reset else "?")
                        raise RateLimited("GitHub API rate limit exhausted (resets %s)" % when)
                    if attempt < 3:
                        time.sleep(delay)
                        delay *= 2
                        continue
                    raise RuntimeError("GitHub HTTP %d for %s" % (e.code, url.split("?")[0]))
                if e.code >= 500 and attempt < 3:
                    time.sleep(delay)
                    delay *= 2
                    continue
                raise RuntimeError("GitHub HTTP %d for %s" % (e.code, url.split("?")[0]))
            except (urllib.error.URLError, TimeoutError, OSError) as e:
                if attempt < 3:
                    time.sleep(delay)
                    delay *= 2
                    continue
                raise RuntimeError("network error for %s: %s" % (url.split("?")[0], e))
        raise RuntimeError("giving up on %s" % url.split("?")[0])

    # ---- registries (anonymous bearer-token flow, works for ghcr + docker hub)
    MANIFEST_ACCEPT = ", ".join([
        "application/vnd.oci.image.index.v1+json",
        "application/vnd.docker.distribution.manifest.list.v2+json",
        "application/vnd.oci.image.manifest.v1+json",
        "application/vnd.docker.distribution.manifest.v2+json",
    ])

    def registry_manifest(self, registry, repo, ref, method="HEAD"):
        """-> (digest, json-or-None). Raises RuntimeError."""
        host = "registry-1.docker.io" if registry == "docker.io" else registry
        url = "https://%s/v2/%s/manifests/%s" % (host, repo, ref)
        token = None
        delay = 2
        for attempt in range(4):
            hdrs = {"Accept": self.MANIFEST_ACCEPT, "User-Agent": UA}
            if token:
                hdrs["Authorization"] = "Bearer " + token
            req = urllib.request.Request(url, headers=hdrs, method=method)
            try:
                with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as r:
                    dg = r.headers.get("Docker-Content-Digest")
                    body = r.read() if method == "GET" else b""
                    data = json.loads(body) if body else None
                    if not dg and body:
                        dg = "sha256:" + hashlib.sha256(body).hexdigest()
                    return dg, data
            except urllib.error.HTTPError as e:
                if e.code == 401 and token is None:
                    token = self._registry_token(e.headers.get("WWW-Authenticate", ""))
                    continue
                if e.code == 404:
                    raise RuntimeError("tag/manifest not found: %s/%s:%s" % (registry, repo, ref))
                if e.code in (429, 500, 502, 503, 504) and attempt < 3:
                    time.sleep(delay)
                    delay *= 2
                    continue
                raise RuntimeError("registry HTTP %d for %s/%s:%s" % (e.code, registry, repo, ref))
            except (urllib.error.URLError, TimeoutError, OSError) as e:
                if attempt < 3:
                    time.sleep(delay)
                    delay *= 2
                    continue
                raise RuntimeError("registry network error: %s" % e)
        raise RuntimeError("registry: giving up on %s/%s:%s" % (registry, repo, ref))

    def _registry_token(self, www_auth):
        m = re.match(r"Bearer\s+(.*)", www_auth or "", re.I)
        if not m:
            raise RuntimeError("registry wants unsupported auth: %r" % www_auth[:60])
        params = dict(re.findall(r'(\w+)="([^"]*)"', m.group(1)))
        realm = params.pop("realm", None)
        if not realm:
            raise RuntimeError("registry auth without realm")
        url = realm + "?" + urllib.parse.urlencode(params)
        req = urllib.request.Request(url, headers={"User-Agent": UA})
        with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as r:
            d = json.loads(r.read())
        return d.get("token") or d.get("access_token")


# --------------------------------------------------------------------------
# discovery of pinned images
# --------------------------------------------------------------------------
IMG_RE = re.compile(r"""^\s*image:\s*["']?([^"'\s#]+)""")
REF_IN_TEXT_RE = re.compile(r"""((?:[\w.-]+(?::\d+)?/)?[\w./-]+(?::[\w][\w.-]*)?@sha256:[0-9a-f]{64})""")


def split_ref(ref):
    """-> dict(registry, repo, tag, digest, name)"""
    digest = None
    if "@" in ref:
        ref, digest = ref.split("@", 1)
    tag = None
    last = ref.rsplit("/", 1)[-1]
    if ":" in last:
        ref, tag = ref.rsplit(":", 1)
    parts = ref.split("/")
    if len(parts) > 1 and ("." in parts[0] or ":" in parts[0] or parts[0] == "localhost"):
        registry, repo = parts[0], "/".join(parts[1:])
    else:
        registry, repo = "docker.io", ref
    if registry == "docker.io" and "/" not in repo:
        repo = "library/" + repo
    name = repo[len("library/"):] if repo.startswith("library/") else repo
    return {"registry": registry, "repo": repo, "tag": tag, "digest": digest,
            "name": name, "key": "%s/%s" % (registry, name)}


def tag_from_comments(lines, idx, img):
    """Digest-only refs: find 'name:tag' for this image in nearby comments."""
    last = img["repo"].rsplit("/", 1)[-1]
    pat = re.compile(r"([\w./-]*\b%s):([\w][\w.-]*)" % re.escape(last))
    for j in range(idx - 1, max(-1, idx - 4), -1):
        if "#" in lines[j]:
            m = pat.search(lines[j].split("#", 1)[1])
            if m:
                return m.group(2)
    if "#" in lines[idx]:
        m = pat.search(lines[idx].split("#", 1)[1])
        if m:
            return m.group(2)
    return None


def discover_images():
    found = []
    files = sorted({f for g in COMPOSE_GLOBS for f in glob.glob(g)})
    for path in files:
        try:
            lines = open(path).read().splitlines()
        except OSError as e:
            warn("cannot read %s: %s" % (path, e))
            continue
        service = None
        for i, line in enumerate(lines):
            sm = re.match(r"^  ([\w.-]+):\s*(#.*)?$", line)
            if sm:
                service = sm.group(1)
            m = IMG_RE.match(line)
            if not m or "${" in m.group(1):
                if m:
                    warn("%s: image uses variable interpolation, skipped: %s" % (path, m.group(1)))
                continue
            img = split_ref(m.group(1))
            img["tag_source"] = "image ref" if img["tag"] else None
            if not img["tag"]:
                img["tag"] = tag_from_comments(lines, i, img)
                img["tag_source"] = "comment" if img["tag"] else None
            img.update(source="%s (%s)" % (path, service or "?"), ref=m.group(1))
            found.append(img)
    try:
        text = open(LLAMA_SWAP_CONFIG).read()
        for m in sorted(set(REF_IN_TEXT_RE.findall(text))):
            img = split_ref(m)
            img["tag_source"] = "image ref" if img["tag"] else None
            img.update(source="%s (macro image)" % LLAMA_SWAP_CONFIG, ref=m)
            found.append(img)
    except OSError as e:
        warn("cannot read %s: %s" % (LLAMA_SWAP_CONFIG, e))
    return files, found


def github_repo_for(img):
    key = img["key"]
    if key in IMAGE_TO_GITHUB:
        return IMAGE_TO_GITHUB[key]
    if img["registry"] == "ghcr.io" and img["repo"].count("/") == 1:
        return img["repo"]  # guess
    return None


def local_image_labels(ref):
    rc, out = run(["docker", "image", "inspect", ref, "--format", "{{json .Config.Labels}}"])
    if rc != 0:
        return {}
    try:
        return json.loads(out) or {}
    except ValueError:
        return {}


def probe_python_version(ref, dist):
    """Read a pip distribution version from inside a LOCAL image (no pull, no net)."""
    code = "import importlib.metadata as m; print(m.version(%r))" % dist
    rc, out = run(["docker", "run", "--rm", "--pull", "never", "--network", "none",
                   "--entrypoint", "python3", ref, "-c", code], timeout=120)
    if rc != 0:
        rc, out = run(["docker", "run", "--rm", "--pull", "never", "--network", "none",
                       "--entrypoint", "python", ref, "-c", code], timeout=120)
    out = out.strip().splitlines()
    return out[-1].strip() if rc == 0 and out else None


