SEV_ORDER = {"critical": 0, "high": 1, "medium": 2, "moderate": 2, "low": 3}


def build_report(ctx):
    L = []
    comps = ctx["components"]
    affected = [(c["name"], a) for c in comps for a in (c.get("gh") or {}).get("advisories", [])
                if a["verdict"] == "AFFECTED"]
    manual = [(c["name"], a) for c in comps for a in (c.get("gh") or {}).get("advisories", [])
              if a["verdict"] == "CHECK MANUALLY"]
    updates = []
    unknown = []
    for c in comps:
        gh = c.get("gh") or {}
        build_lag = (gh.get("repo") in BUILD_TAG_REPOS
                     and (c.get("digest") or {}).get("status") == "current")
        if gh.get("release_status") == "newer" and not c.get("hermes") and not build_lag:
            updates.append("%s %s→%s" % (c["name"], c.get("current") or "?", gh.get("latest")))
        if (c.get("digest") or {}).get("status") == "newer":
            updates.append("%s (newer `%s` build)" % (c["name"], c["tag"]))
        if c.get("hermes", {}).get("status") == "newer":
            updates.append("%s %s commits behind upstream (latest release %s)" % (
                c["name"], c["hermes"]["behind"], gh.get("latest") or "?"))
        if gh and (gh.get("release_status") == "unknown" or gh.get("adv_status") == "unknown"):
            unknown.append(c["name"])
        if c.get("digest") and c["digest"]["status"] == "unknown":
            unknown.append(c["name"] + " digest")
        if c.get("hermes") and c["hermes"]["status"] == "unknown":
            unknown.append(c["name"])
    os_ = ctx["os"]
    nsec = len(os_["security"])
    nup = len(os_["upgradable"])
    drv_new = [p for p, v in os_["policy"].items() if p.startswith("nvidia-driver-")
               and v["candidate"] and v["installed"] and v["candidate"] != v["installed"]]
    if nup:
        updates.append("apt: %d upgradable (%d security)" % (nup, nsec))
    if drv_new:
        updates.append("NVIDIA driver %s→%s" % (os_["policy"][drv_new[0]]["installed"].split("-")[0],
                                               os_["policy"][drv_new[0]]["candidate"].split("-")[0]))
    if affected:
        status = "SECURITY: %d advisories affect current versions" % len(affected)
        code = 20
    elif updates:
        status = "UPDATES AVAILABLE"
        code = 10
    else:
        status = "OK"
        code = 0
    extra = []
    if updates:
        extra.append("; ".join(updates))
    if manual:
        extra.append("%d advisories need manual check" % len(manual))
    if unknown:
        extra.append("unknown: " + ", ".join(sorted(set(unknown))))
    if ctx["http"].stale:
        extra.append("some GitHub data served from cache (rate limited)")
    summary = status + (" — " + " | ".join(extra) if extra else "")
    ctx["summary"], ctx["code"] = summary, code

    ts = ctx["started"].strftime("%Y-%m-%d %H:%M UTC")
    L.append("# Spark update check — %s (host %s)" % (ts, os.uname().nodename))
    L.append("")
    L.append("**Summary:** " + summary)
    L.append("")
    L.append("_Report only — nothing was pulled, upgraded or restarted. "
             "See README.md in this directory for the safe update procedure._")
    L.append("")
    if affected:
        L.append("## ⚠ Advisories affecting current versions")
        L.append("")
        L.append("| Component | Advisory | Severity | Published | Range → patched | Summary |")
        L.append("|---|---|---|---|---|---|")
        for n, a in sorted(affected, key=lambda x: SEV_ORDER.get(x[1]["severity"], 9)):
            L.append("| %s | [%s](%s) | %s | %s | %s | %s |" % (
                n, a["id"], a["url"], a["severity"], a["published"], md_escape(a["ranges"]),
                md_escape(a["summary"])))
        L.append("")
    L.append("## Components")
    L.append("")
    L.append("| Component | Current | Latest release | Pinned digest vs upstream tag | Advisories (affecting / manual / total) |")
    L.append("|---|---|---|---|---|")
    for c in comps:
        gh = c.get("gh") or {}
        rel = "—"
        if gh:
            st = gh.get("release_status")
            rel = "%s (%s)" % (gh.get("latest") or "?", {"newer": "**UPDATE**", "current": "up to date"}.get(st, "unknown"))
            if gh.get("builds_behind"):
                rel += ", %d builds behind" % gh["builds_behind"]
                if (c.get("digest") or {}).get("status") == "current":
                    rel = rel.replace("**UPDATE**", "newer source builds") + \
                        " (image tag not rebuilt yet — informational)"
        if c.get("hermes"):
            h = c["hermes"]
            rel += "; %s" % ("**%s commits behind** upstream %s" % (h.get("behind"), h.get("branch"))
                             if h["status"] == "newer" else
                             ("in sync with upstream %s" % h.get("branch") if h["status"] == "current"
                              else "upstream compare unknown"))
        dg = c.get("digest")
        dcell = "—"
        if dg:
            dcell = {"newer": "**newer build available**", "current": "current",
                     "unknown": "unknown"}[dg["status"]]
            if dg.get("unpinned"):
                dcell += " (NOT digest-pinned)"
            if dg.get("detail"):
                dcell += ": " + dg["detail"]
        adv = "—"
        if gh:
            if gh.get("adv_status") == "ok":
                al = gh["advisories"]
                adv = "%d / %d / %d" % (sum(a["verdict"] == "AFFECTED" for a in al),
                                         sum(a["verdict"] == "CHECK MANUALLY" for a in al), len(al))
            else:
                adv = "unknown"
        L.append("| %s | %s | %s | %s | %s |" % (md_escape(c["name"]), md_escape(c.get("current") or "?"),
                                                md_escape(rel), md_escape(dcell), adv))
    L.append("")
    L.append("Sources:")
    L.append("")
    for c in comps:
        L.append("- **%s**: %s" % (c["name"], c["source"]))
    L.append("")
    if manual:
        L.append("## Advisories to check manually")
        L.append("")
        L.append("Version data in these advisories could not be compared automatically and they "
                 "were published after the current release.")
        L.append("")
        for n, a in manual:
            L.append("- %s: [%s](%s) %s (%s) — %s. _%s_" % (n, a["id"], a["url"], a["severity"],
                                                          a["published"], md_escape(a["summary"]),
                                                          md_escape(a["note"])))
        L.append("")
    # OS
    L.append("## Walter OS")
    L.append("")
    L.append("- apt: **%d upgradable, %d from -security** (package lists %s h old; "
             "this check does not run `apt update`)" % (nup, nsec, os_["lists_age_h"]))
    if os_["security"]:
        L.append("  - security: " + ", ".join("%s %s" % (p["name"], p["new"]) for p in os_["security"]))
    L.append("- unattended-upgrades: service %s, apt-daily %s, apt-daily-upgrade %s; last run %s" % (
        os_["unattended-upgrades.service"], os_["apt-daily.timer"], os_["apt-daily-upgrade.timer"],
        os_["uu_last_run"] or "never/unknown"))
    L.append("- reboot required: %s%s" % ("**yes**" if os_["reboot_required"] else "no",
                                         (" (" + ", ".join(os_["reboot_pkgs"]) + ")") if os_["reboot_pkgs"] else ""))
    if os_["held"]:
        L.append("- held packages: " + ", ".join(os_["held"]))
    L.append("- NVIDIA driver loaded: %s; packages: %s" % (
        ", ".join(os_["nvidia_loaded"] or ["unknown"]),
        ", ".join("%s %s" % kv for kv in os_["nvidia_driver_pkgs"].items()) or "none"))
    if len(os_["nvidia_driver_pkgs"]) > 1:
        L.append("  - note: more than one nvidia-driver-* package installed")
    for p, v in os_["policy"].items():
        flag = "**update available**" if v["candidate"] and v["candidate"] != v["installed"] else "current"
        L.append("  - %s: installed %s, candidate %s (%s)" % (p, v["installed"], v["candidate"], flag))
    if os_["nvidia_branches"]:
        L.append("  - driver branches in apt: " + ", ".join(map(str, os_["nvidia_branches"][-4:])))
    L.append("")
    # full advisory listing
    L.append("## Advisory details")
    L.append("")
    for c in comps:
        gh = c.get("gh") or {}
        if not gh:
            continue
        al = gh.get("advisories") or []
        L.append("<details><summary>%s (%s): %d advisories</summary>" % (c["name"], gh["repo"], len(al)))
        L.append("")
        if al:
            L.append("| Advisory | Sev | Published | Range → patched | Verdict | Note |")
            L.append("|---|---|---|---|---|---|")
            for a in sorted(al, key=lambda a: a["published"], reverse=True):
                L.append("| [%s](%s) | %s | %s | %s | %s | %s |" % (
                    a["id"], a["url"], a["severity"], a["published"], md_escape(a["ranges"]),
                    a["verdict"], md_escape(a["note"])))
        L.append("")
        L.append("</details>")
        L.append("")
    errs = [(c["name"], e) for c in comps for e in (c.get("gh") or {}).get("errors", [])]
    errs += [(c["name"], e) for c in comps for e in (c.get("hermes") or {}).get("errors", [])]
    errs = list(dict.fromkeys(errs))
    errs += [("GitHub cache", s_) for s_ in sorted(ctx["http"].stale)]
    if errs or WARNINGS:
        L.append("## Check errors / unknowns")
        L.append("")
        for n, e in errs:
            L.append("- %s: %s" % (n, md_escape(e)))
        for w in WARNINGS:
            L.append("- %s" % md_escape(w))
        L.append("")
    L.append("---")
    L.append("Compose files scanned: %s. GitHub API calls: %d (auth: %s, remaining: %s). Runtime %.0fs." % (
        ", ".join(ctx["compose_files"]) or "none", ctx["http"].gh_calls,
        "token" if ctx["http"].token else "anonymous", ctx["http"].gh_remaining,
        (now() - ctx["started"]).total_seconds()))
    return "\n".join(L) + "\n"


# --------------------------------------------------------------------------
def main():
    ap = argparse.ArgumentParser(description="Report-only update/security checker")
    ap.add_argument("--stdout", action="store_true", help="print report instead of writing files")
    ap.add_argument("--assume", action="append", default=[], metavar="OWNER/REPO=VERSION",
                    help="testing: pretend the current version of a GitHub repo is VERSION")
    ap.add_argument("--simulate-rate-limit", action="store_true",
                    help="testing: behave as if the GitHub API quota were exhausted")
    args = ap.parse_args()
    assume = dict(a.split("=", 1) for a in args.assume)
    started = now()
    token = None
    try:
        with open(TOKEN_FILE) as f:
            token = f.read().strip() or None
    except OSError:
        pass
    http = Http(token)
    if args.simulate_rate_limit:
        http.gh_exhausted = True

    compose_files, images = discover_images()
    components = []
    gh_done = {}
    merged = {}
    for img in images:
        if img["ref"] in merged:
            merged[img["ref"]]["source"] += "; " + img["source"]
            continue
        merged[img["ref"]] = img
    for img in merged.values():
        name = img["name"].rsplit("/", 1)[-1] + (":" + img["tag"] if img["tag"] else "")
        c = {"name": name, "tag": img["tag"], "source": img["source"] +
             (" — tag from %s" % img["tag_source"] if img.get("tag_source") == "comment" else "")}
        if not img["digest"]:
            c["source"] += " — **not digest-pinned**"
        labels = local_image_labels(img["ref"])
        repo = github_repo_for(img)
        cur = None
        cur_date = None
        if repo in BUILD_TAG_REPOS:
            cur = labels.get("org.opencontainers.image.version")
            cur_date = labels.get("org.opencontainers.image.created")
        elif img["tag"] and parse_ver(img["tag"]):
            cur = img["tag"]
        elif labels.get("org.opencontainers.image.version") and parse_ver(labels["org.opencontainers.image.version"]):
            cur = labels["org.opencontainers.image.version"]
        if repo in PY_VERSION_PROBE:
            pv = probe_python_version(img["ref"], PY_VERSION_PROBE[repo])
            if pv and cur and parse_ver(pv) != parse_ver(cur):
                warn("%s: tag/comment says %s but the pinned image contains %s %s; using %s"
                     % (name, cur, PY_VERSION_PROBE[repo], pv, pv))
                cur = pv
            elif pv and not cur:
                cur = pv
            elif not pv:
                warn("%s: could not read package version from the pinned image" % name)
        if repo in assume:
            cur = assume[repo]
        c["current"] = cur
        c["digest"] = check_digest(http, img)
        if repo:
            k = (repo, cur)
            if k not in gh_done:
                gh_done[k] = check_github(http, repo, cur, cur_date)
            c["gh"] = gh_done[k]
        components.append(c)

    lsv = check_llama_swap()
    c = {"name": "llama-swap", "current": lsv, "source": LLAMA_SWAP_BIN + " --version"}
    c["gh"] = check_github(http, "mostlygeek/llama-swap", lsv)
    components.append(c)

    h = check_hermes(http)
    components.append({"name": "hermes-agent", "current": "%s (%s)" % (h.get("describe", "?"), (h.get("head") or "?")[:10]),
                       "source": HERMES_DIR + (" (local changes present)" if h.get("dirty") else ""),
                       "hermes": h, "gh": h.get("github")})

    ctx = {"started": started, "components": components, "os": check_os(), "http": http,
           "compose_files": compose_files}
    report = build_report(ctx)
    if args.stdout:
        sys.stdout.write(report)
    else:
        os.makedirs(STATE_DIR, exist_ok=True)
        path = os.path.join(STATE_DIR, "report-%s.md" % started.strftime("%Y-%m-%d"))
        with open(path + ".tmp", "w") as f:
            f.write(report)
        os.chmod(path + ".tmp", 0o644)
        os.replace(path + ".tmp", path)
        link = os.path.join(STATE_DIR, "latest.md")
        tmp = link + ".tmp"
        if os.path.lexists(tmp):
            os.unlink(tmp)
        os.symlink(os.path.basename(path), tmp)
        os.replace(tmp, link)
        # keep ~1 year of weekly reports
        for old in sorted(glob.glob(os.path.join(STATE_DIR, "report-*.md")))[:-60]:
            os.unlink(old)
    print("spark-update-check: " + ctx["summary"], file=sys.stderr if args.stdout else sys.stdout)
    return ctx["code"]


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:  # noqa: BLE001
        print("spark-update-check: ERROR %s: %s" % (type(e).__name__, e), file=sys.stderr)
        sys.exit(1)
