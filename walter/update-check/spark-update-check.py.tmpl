def check_digest(http, img):
    """Compare pinned digest with what the tag resolves to upstream."""
    res = {"status": "unknown", "detail": ""}
    tag = img.get("tag")
    pinned = img.get("digest")
    if not pinned:
        rc, out = run(["docker", "image", "inspect", img["ref"], "--format",
                       "{{json .RepoDigests}}"])
        try:
            rds = json.loads(out) if rc == 0 else []
        except ValueError:
            rds = []
        pinned = rds[0].split("@", 1)[1] if rds else None
        res["unpinned"] = True
    if not tag:
        res["detail"] = "no tag known for digest-only ref (add a '# name:tag' comment)"
        return res
    try:
        up, _ = http.registry_manifest(img["registry"], img["repo"], tag)
    except Exception as e:  # noqa: BLE001
        res["detail"] = str(e)
        return res
    res["upstream"] = up
    if not pinned:
        res.update(status="unknown", detail="image not present locally; upstream %s" % up[:19])
        return res
    if up == pinned:
        res.update(status="current", detail="tag `%s` still resolves to pinned digest" % tag)
        return res
    # pinned might be a platform manifest inside the upstream index
    try:
        _, idx = http.registry_manifest(img["registry"], img["repo"], up, method="GET")
        children = [m.get("digest") for m in (idx or {}).get("manifests", [])]
        if pinned in children:
            res.update(status="current", detail="pinned digest is a platform manifest of the current index")
            return res
    except Exception:  # noqa: BLE001
        pass
    res.update(status="newer", detail="tag `%s` now -> %s (pinned %s)" % (tag, up[:19], pinned[:19]))
    return res


def check_github(http, repo, cur_text, cur_date=None):
    """Latest release + advisories for a repo against the current version."""
    r = {"repo": repo, "current": cur_text, "latest": None, "latest_date": None,
         "release_status": "unknown", "advisories": [], "adv_status": "unknown",
         "errors": [], "cur_date": cur_date}
    cur = parse_ver(cur_text) if cur_text else None
    # latest release
    try:
        if repo in BUILD_TAG_REPOS:
            rels = http._gh_get("https://api.github.com/repos/%s/releases?per_page=20" % repo)[0]
            rels = [x for x in rels if not x.get("draft")
                    and re.match(BUILD_TAG_REPOS[repo], x.get("tag_name", ""))]
            rel = rels[0] if rels else None
        else:
            rel = http.github("/repos/%s/releases/latest" % repo)
        if rel:
            r["latest"], r["latest_date"] = rel.get("tag_name"), rel.get("published_at")
            lv = parse_ver(r["latest"])
            if cur and lv and cur.kind == lv.kind:
                r["release_status"] = "newer" if lv > cur else "current"
                if repo in BUILD_TAG_REPOS and lv > cur:
                    r["builds_behind"] = lv.key[0] - cur.key[0]
            elif cur_text and r["latest"] and cur_text.lstrip("v") == r["latest"].lstrip("v"):
                r["release_status"] = "current"
            elif not cur_text:
                r["release_status"] = "n/a"
                r["errors"].append("current version not derivable from tag/labels; "
                                   "latest release is %s" % r["latest"])
            else:
                r["release_status"] = "unknown"
                r["errors"].append("cannot compare current %r with latest %r" % (cur_text, r["latest"]))
    except RateLimited as e:
        r["errors"].append(str(e))
    except Exception as e:  # noqa: BLE001
        r["errors"].append("releases: %s" % e)
    # current release date, fetched lazily (only needed for date fallback)
    def cur_date_fn():
        if "cur_dt" in r:
            return r["cur_dt"]
        if not r["cur_date"] and cur_text:
            vpref = (r["latest"] or "v").startswith("v")
            bare = cur_text.lstrip("v")
            for t in (["v" + bare, bare] if vpref else [bare, "v" + bare]):
                try:
                    rel = http.github("/repos/%s/releases/tags/%s" % (repo, urllib.parse.quote(t)))
                    r["cur_date"] = rel.get("published_at")
                    break
                except RateLimited as e:
                    r["errors"].append(str(e))
                    break
                except Exception:  # noqa: BLE001
                    continue
        r["cur_dt"] = parse_iso(r["cur_date"])
        return r["cur_dt"]
    # advisories
    try:
        advs = http.github("/repos/%s/security-advisories" % repo,
                           {"state": "published", "per_page": 100})
        for a in advs:
            if a.get("withdrawn_at"):
                continue
            if cur is None:
                verdict, note = "n/a", "current version unknown"
            else:
                verdict, note = evaluate_advisory(a, cur, cur_date_fn)
            r["advisories"].append({
                "id": a.get("ghsa_id"), "cve": a.get("cve_id"),
                "severity": a.get("severity"), "published": (a.get("published_at") or "")[:10],
                "summary": a.get("summary") or "", "url": a.get("html_url"),
                "ranges": "; ".join("%s -> %s" % (v.get("vulnerable_version_range"),
                                                   v.get("patched_versions"))
                                    for v in a.get("vulnerabilities") or []),
                "verdict": verdict, "note": note})
        r["adv_status"] = "ok"
    except RateLimited as e:
        r["errors"].append(str(e))
    except Exception as e:  # noqa: BLE001
        r["errors"].append("advisories: %s" % e)
    return r


def check_hermes(http):
    res = {"path": HERMES_DIR, "status": "unknown", "errors": []}
    git = ["git", "-c", "safe.directory=*", "-C", HERMES_DIR]
    rc, head = run(git + ["rev-parse", "HEAD"])
    if rc != 0:
        res["errors"].append("not a git checkout / unreadable")
        return res
    res["head"] = head.strip()
    rc, desc = run(git + ["describe", "--tags", "--always"])
    res["describe"] = desc.strip() if rc == 0 else "?"
    rc, cdate = run(git + ["log", "-1", "--format=%cI"])
    res["head_date"] = cdate.strip()
    rc, st = run(git + ["status", "--porcelain", "--untracked-files=no"])
    res["dirty"] = bool(st.strip()) if rc == 0 else None
    rc, br = run(git + ["rev-parse", "--abbrev-ref", "HEAD"])
    branch = br.strip() if rc == 0 and br.strip() != "HEAD" else "main"
    res["branch"] = branch
    try:
        cmp_ = http.github("/repos/%s/compare/%s...%s" % (HERMES_REPO, res["head"], branch))
        res["behind"] = cmp_.get("ahead_by")   # upstream commits we don't have
        res["ahead"] = cmp_.get("behind_by")   # local commits upstream doesn't have
        res["status"] = "newer" if res["behind"] else "current"
    except Exception as e:  # noqa: BLE001
        res["errors"].append("compare: %s" % e)
    tagbase = re.sub(r"-\d+-g[0-9a-f]+$", "", res["describe"])
    gh = check_github(http, HERMES_REPO, tagbase, res["head_date"])
    res["github"] = gh
    return res


def check_llama_swap():
    rc, out = run([LLAMA_SWAP_BIN, "--version"])
    m = re.search(r"version:\s*(\S+)", out or "")
    return m.group(1) if rc == 0 and m else None


def check_os():
    o = {"errors": []}
    rc, out = run(["apt", "list", "--upgradable"], timeout=120)
    pk = []
    for line in out.splitlines():
        m = re.match(r"^([^/\s]+)/(\S+)\s+(\S+)\s+\S+\s+\[upgradable from: ([^\]]+)\]", line)
        if m:
            pk.append({"name": m.group(1), "suite": m.group(2), "new": m.group(3), "old": m.group(4)})
    o["upgradable"] = pk
    o["security"] = [p for p in pk if "-security" in p["suite"]]
    lists = glob.glob("/var/lib/apt/lists/*InRelease")
    o["lists_age_h"] = (round((time.time() - max(os.path.getmtime(f) for f in lists)) / 3600, 1)
                        if lists else None)
    for unit in ("unattended-upgrades.service", "apt-daily.timer", "apt-daily-upgrade.timer"):
        rc, out = run(["systemctl", "is-enabled", unit])
        o[unit] = out.strip() or "unknown"
    try:
        with open("/var/log/unattended-upgrades/unattended-upgrades.log") as f:
            starts = [l[:19] for l in f if "Starting unattended upgrades script" in l]
        o["uu_last_run"] = starts[-1] if starts else None
    except OSError:
        o["uu_last_run"] = None
    o["reboot_required"] = os.path.exists("/var/run/reboot-required")
    try:
        o["reboot_pkgs"] = open("/var/run/reboot-required.pkgs").read().split()
    except OSError:
        o["reboot_pkgs"] = []
    rc, out = run(["apt-mark", "showhold"])
    o["held"] = out.split() if rc == 0 else []
    # NVIDIA driver
    rc, out = run(["nvidia-smi", "--query-gpu=driver_version", "--format=csv,noheader"])
    o["nvidia_loaded"] = sorted(set(out.split())) if rc == 0 else None
    rc, out = run(["dpkg-query", "-W", "-f", "${Package} ${Version} ${db:Status-Abbrev}\n"])
    inst = {}
    for line in out.splitlines():
        parts = line.split()
        if len(parts) >= 3 and parts[2].startswith("ii"):
            inst[parts[0]] = parts[1]
    o["nvidia_driver_pkgs"] = {k: v for k, v in inst.items() if re.match(r"^nvidia-driver-\d+", k)}
    watch = list(o["nvidia_driver_pkgs"]) + [p for p in ("nvidia-container-toolkit", "docker-ce",
                                                         "containerd.io", "docker-ce-cli")
                                             if p in inst]
    pol = {}
    for p in watch:
        rc, out = run(["apt-cache", "policy", p])
        m = re.search(r"Candidate:\s*(\S+)", out)
        pol[p] = {"installed": inst.get(p), "candidate": m.group(1) if m else None}
    o["policy"] = pol
    # newer driver branches available (informational)
    rc, out = run(["apt-cache", "pkgnames", "nvidia-driver-"])
    br = sorted({int(m.group(1)) for m in re.finditer(r"^nvidia-driver-(\d+)(?:-open)?$", out, re.M)})
    o["nvidia_branches"] = br
    return o


