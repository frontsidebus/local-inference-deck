FAST_QUERIES = {
    "gpu_util": "DCGM_FI_DEV_GPU_UTIL",
    "gpu_fb_used": "DCGM_FI_DEV_FB_USED",
    "gpu_fb_free": "DCGM_FI_DEV_FB_FREE",
    "gpu_fb_reserved": "DCGM_FI_DEV_FB_RESERVED",
    "gpu_temp": "DCGM_FI_DEV_GPU_TEMP",
    "gpu_power": "DCGM_FI_DEV_POWER_USAGE",
    "gpu_sm_clock": "DCGM_FI_DEV_SM_CLOCK",
    "gpu_fan": "llamaswap_gpu_fan_speed_percent",
    # decode speed while generating (tokens / seconds spent generating) and raw throughput
