def _num(v):
    try:
        f = float(v)
    except (TypeError, ValueError):
        return None
    return None if math.isnan(f) or math.isinf(f) else f


def _r(v, nd=2):
    return None if v is None else round(v, nd)


class Collector:
    def __init__(self) -> None:
        self.client = httpx.AsyncClient(timeout=httpx.Timeout(5.0, connect=2.0))
        self.fast: dict = {}
        self.slow: dict = {}
        self.running: list = []
        self.sources: dict = {
            "prometheus": {"ok": False, "error": "starting"},
            "llama_swap": {"ok": False, "error": "starting"},
            "backup": {"ok": False, "error": "starting"},
            "alerts": {"ok": False, "error": "starting"},
        }
        self.alerts: list = []
        self.backup: dict | None = None
        self.history: dict = {"window_s": HIST_WINDOW, "step_s": HIST_STEP, "series": {}}
        self.snapshot: dict = {}
        self.snapshot_bytes: bytes = b"{}"
        self.history_bytes: bytes = b"{}"
        self.seq = 0
        self.cond = asyncio.Condition()
        self.sse_clients = 0

    # ---------------- Prometheus ----------------
    async def prom_query(self, q: str) -> list:
        r = await self.client.get(f"{PROM}/api/v1/query", params={"query": q})
        r.raise_for_status()
        d = r.json()
        if d.get("status") != "success":
            raise RuntimeError(d.get("error", "query failed"))
        return d["data"]["result"]

    async def prom_batch(self, queries: dict) -> dict:
        names = list(queries)
        t0 = time.monotonic()
        res = await asyncio.gather(*(self.prom_query(queries[n]) for n in names), return_exceptions=True)
        out, errs = {}, 0
        for n, r in zip(names, res):
            if isinstance(r, Exception):
                errs += 1
                log.debug("query %s failed: %s", n, r)
                out[n] = None
            else:
                out[n] = r
        ok = errs < len(names)
        self.sources["prometheus"] = {
            "ok": ok,
            "latency_ms": round((time.monotonic() - t0) * 1000, 1),
            **({} if ok else {"error": "unreachable"}),
        }
        return out

    async def prom_range(self, q: str, start: float, end: float) -> list:
        r = await self.client.get(
            f"{PROM}/api/v1/query_range", params={"query": q, "start": start, "end": end, "step": HIST_STEP}
        )
        r.raise_for_status()
        return r.json()["data"]["result"]

    async def refresh_history(self) -> None:
        end = time.time()
        start = end - HIST_WINDOW
        names = list(HISTORY_QUERIES)
        res = await asyncio.gather(
            *(self.prom_range(HISTORY_QUERIES[n], start, end) for n in names), return_exceptions=True
        )
        series = {}
        for n, r in zip(names, res):
            if isinstance(r, Exception):
                continue
            for s in r:
                key = n if n != "gpu_util" else f"gpu{s['metric'].get('gpu', '?')}"
                series[key] = [[int(float(t)), _r(_num(v), 2)] for t, v in s["values"]]
        self.history = {"window_s": HIST_WINDOW, "step_s": HIST_STEP, "series": series}
        self.history_bytes = json.dumps(self.history, separators=(",", ":")).encode()

    async def refresh_alerts(self) -> None:
        try:
            r = await self.client.get(f"{PROM}/api/v1/alerts")
            r.raise_for_status()
            alerts = []
            for a in r.json()["data"]["alerts"]:
                lab = a.get("labels", {})
                alerts.append(
                    {
                        "name": lab.get("alertname", "?"),
                        "state": a.get("state"),
                        "severity": lab.get("severity", "none"),
                        "summary": (a.get("annotations", {}).get("summary") or "")[:200],
                        "since": a.get("activeAt"),
                    }
                )
            self.alerts = alerts
            self.sources["alerts"] = {"ok": True}
        except Exception as e:  # noqa: BLE001
            self.sources["alerts"] = {"ok": False, "error": type(e).__name__}

    # ---------------- llama-swap ----------------
    async def refresh_running(self) -> None:
        try:
            key = Path(LLAMA_SWAP_KEY_FILE).read_text().strip()
            r = await self.client.get(f"{LLAMA_SWAP}/running", headers={"Authorization": f"Bearer {key}"})
            del key
            r.raise_for_status()
            running = []
            for m in r.json().get("running", []):
                mid = str(m.get("model", ""))
                gpus = STATIC_GPUS.get(mid, [])
                mm = re.search(r"device=([0-9,]+)", m.get("cmd", "") or "")
                if mm:
                    gpus = [int(x) for x in mm.group(1).split(",") if x.isdigit()]
                # only pass through safe, non-secret fields (never cmd/proxy)
                running.append({"id": mid, "state": str(m.get("state", "?"))[:32], "gpus": gpus, "ttl": m.get("ttl")})
            self.running = running
            self.sources["llama_swap"] = {"ok": True}
        except Exception as e:  # noqa: BLE001
            self.sources["llama_swap"] = {"ok": False, "error": type(e).__name__}

    # ---------------- backup marker (written by the root sidecar) ----------------
    def refresh_backup(self) -> None:
        try:
            d = json.loads(Path(BACKUP_FILE).read_text())
            ts = datetime.fromisoformat(d["ts"]).timestamp()
            self.backup = {"name": str(d["name"])[:64], "ts": int(ts)}
            stale = time.time() - float(d.get("checked", 0)) > 600
            self.sources["backup"] = {"ok": not stale, **({"error": "status file stale"} if stale else {})}
        except Exception as e:  # noqa: BLE001
            self.backup = None
            self.sources["backup"] = {"ok": False, "error": type(e).__name__}

    # ---------------- snapshot assembly ----------------
    def build(self) -> dict:
        f, s = self.fast, self.slow

        def by(res, label):
            out = {}
            for x in res or []:
                out[x["metric"].get(label, "")] = _num(x["value"][1])
            return out

        def scalar(res):
            if res:
                return _num(res[0]["value"][1])
            return None

        # GPUs
        gpus = []
        util, used, free, resv = by(f.get("gpu_util"), "gpu"), by(f.get("gpu_fb_used"), "gpu"), by(
            f.get("gpu_fb_free"), "gpu"
        ), by(f.get("gpu_fb_reserved"), "gpu")
        temp, power, clock = by(f.get("gpu_temp"), "gpu"), by(f.get("gpu_power"), "gpu"), by(f.get("gpu_sm_clock"), "gpu")
        fan = by(f.get("gpu_fan"), "id")
        names, buses = {}, {}
        for x in f.get("gpu_util") or []:
            names[x["metric"].get("gpu")] = x["metric"].get("modelName", "GPU")
            buses[x["metric"].get("gpu")] = x["metric"].get("pci_bus_id", "")
        for g in sorted(util or names, key=lambda k: int(k) if k.isdigit() else 99):
            tot = None
            if used.get(g) is not None and free.get(g) is not None:
                tot = used[g] + free[g] + (resv.get(g) or 0)
            gi = int(g) if g.isdigit() else -1
            gpus.append(
                {
                    "index": gi,
                    "name": names.get(g, "GPU"),
                    "util": util.get(g),
                    "vram_used_mib": used.get(g),
                    "vram_total_mib": tot,
                    "temp_c": temp.get(g),
                    "power_w": _r(power.get(g), 1),
                    "fan_pct": fan.get(g),
                    "sm_clock_mhz": clock.get(g),
                    "pcie": pcie_describe(pcie_link(buses.get(g, "")), expected_width(gi, EXPECTED_WIDTHS)),
                    "models": [m["id"] for m in self.running if gi in m["gpus"]],
                }
            )

        # Models: every configured model, merged with live state + llama-server metrics
        cfg = {x["metric"].get("model"): x["metric"].get("model_name", "") for x in (s.get("models_cfg") or [])}
        run = {m["id"]: m for m in self.running}
        dec, pre, gen = by(f.get("m_decode_tps"), "model"), by(f.get("m_prompt_tps"), "model"), by(
            f.get("m_gen_rate"), "model"
        )
        calls = by(f.get("m_decode_calls"), "model")
        proc, dfr, last = by(f.get("m_processing"), "model"), by(f.get("m_deferred"), "model"), by(
            f.get("m_last_decode_tps"), "model"
        )
        models = []
        for mid in list(dict.fromkeys(list(cfg) + list(run))):
            if not mid:
                continue
            r_ = run.get(mid)
            models.append(
                {
                    "id": mid,
                    "name": cfg.get(mid) or mid,
                    "alias": ALIASES.get(mid),
                    "state": r_["state"] if r_ else "unloaded",
                    "gpus": r_["gpus"] if r_ else STATIC_GPUS.get(mid, []),
                    "decode_tps": _r(dec.get(mid), 1),
                    "prompt_tps": _r(pre.get(mid), 1),
                    "gen_rate": _r(gen.get(mid), 2),
                    "decode_calls_s": _r(calls.get(mid), 1) if r_ else None,
                    "last_decode_tps": _r(last.get(mid), 1) if r_ else None,
                    "processing": proc.get(mid) if r_ else None,
                    "deferred": dfr.get(mid) if r_ else None,
                }
            )
        order = {"ready": 0, "starting": 1, "stopping": 2, "unloaded": 9}
        models.sort(key=lambda m: (order.get(m["state"], 5), m["id"]))

        # Gateway
        keys = {}
        for metric, field in (("key_req", "requests"), ("key_err", "errors"), ("key_in", "tokens_in"), ("key_out", "tokens_out")):
            for alias, v in by(s.get(metric), "api_key_alias").items():
                a = alias if alias and alias != "None" else "(no alias)"
                keys.setdefault(a, {"alias": a, "requests": 0, "errors": 0, "tokens_in": 0, "tokens_out": 0})
                keys[a][field] += round(v or 0)
        gateway = {
            "rpm": _r(scalar(f.get("gw_rpm")), 2),
            "in_flight": scalar(f.get("gw_inflight")),
            "p50_s": _r(scalar(s.get("gw_p50")), 3),
            "p95_s": _r(scalar(s.get("gw_p95")), 3),
            "ttft_p50_s": _r(scalar(s.get("gw_ttft_p50")), 3),
            "requests_1h": round(scalar(s.get("gw_req_1h")) or 0),
            "errors_1h": round(scalar(s.get("gw_err_1h")) or 0),
            "tokens_in_1h": round(scalar(s.get("gw_tok_in_1h")) or 0),
            "tokens_out_1h": round(scalar(s.get("gw_tok_out_1h")) or 0),
            "keys_today": sorted(keys.values(), key=lambda k: -k["requests"]),
            "today_since": local_midnight().isoformat(),
        }

        # Host
        mt, ma = scalar(f.get("mem_total")), scalar(f.get("mem_avail"))
        size, avail = by(s.get("fs_size"), "mountpoint"), by(s.get("fs_avail"), "mountpoint")
        rx, tx = by(f.get("net_rx"), "device"), by(f.get("net_tx"), "device")
        host = {
            "cpu_pct": _r(scalar(f.get("cpu_pct")), 1),
            "load1": _r(scalar(f.get("load1")), 2),
            "mem_total": mt,
            "mem_used": (mt - ma) if mt is not None and ma is not None else None,
            "disks": [
                {"mount": m, "size": size[m], "used": size[m] - (avail.get(m) or 0)}
                for m in ("/", "${MODELS_DIR}")
                if size.get(m)
            ],
            "net": [{"dev": d, "rx_bps": _r(rx.get(d), 0), "tx_bps": _r(tx.get(d), 0)} for d in ("wg0", "${BACKEND_LAN_IF}") if d in rx],
        }

        # Services (blackbox probes)
        ok, dur, code, cert = (by(s.get(k), "instance") for k in ("probe_ok", "probe_dur", "probe_code", "probe_cert"))
        services = []
        for inst, v in ok.items():
            name, scope = PROBE_NAMES.get(inst, (re.sub(r"^https?://", "", inst)[:40], "?"))
            services.append(
                {
                    "name": name,
                    "scope": scope,
                    "up": v == 1,
                    "latency_ms": _r((dur.get(inst) or 0) * 1000, 1),
                    "status": int(code[inst]) if code.get(inst) else None,
                    "cert_days": _r(cert[inst] / 86400, 1) if cert.get(inst) else None,
                }
            )
        services.sort(key=lambda x: (x["scope"] != "public", x["name"]))

        # Scrape targets
        down = []
        tot_up = 0
        for x in s.get("up") or []:
            # The hypervisor exporter is optional and has its own indicator (snapshot.hypervisor.up,
            # "HYPERVISOR OFFLINE"): it never counts towards the overall status.
            if x["metric"].get("job") == "hypervisor":
                continue
            if _num(x["value"][1]) == 1:
                tot_up += 1
            else:
                down.append(f'{x["metric"].get("job")}/{x["metric"].get("instance")}')
        targets = {"up": tot_up, "total": tot_up + len(down), "down": down}

        try:
            hypervisor = hypervisor_view(f)
        except Exception:  # noqa: BLE001  (belt and braces: never let the gaming panel break the snapshot)
            log.exception("hypervisor view failed")
            hypervisor = hypervisor_view({})

        firing = [a for a in self.alerts if a["state"] == "firing"]
        pending = [a for a in self.alerts if a["state"] == "pending"]

        # Overall status
        reasons, level = [], "ok"
        if firing:
            level = "alert"
            reasons.append(f"{len(firing)} alert{'s' if len(firing) != 1 else ''} firing")
        for src, st in self.sources.items():
            if not st.get("ok"):
                reasons.append(f"{src.replace('_', '-')} unavailable")
        for sv in services:
            if not sv["up"]:
                reasons.append(f"probe {sv['name']} failing")
        if down:
            reasons.append(f"{len(down)} scrape target{'s' if len(down) != 1 else ''} down")
        if level == "ok" and reasons:
            level = "degraded"

        now = time.time()
        backup = None
        if self.backup:
            backup = {"name": self.backup["name"], "age_s": int(now - self.backup["ts"])}

        return {
            "ts": round(now, 3),
            "seq": self.seq,
            "status": {"level": level, "reasons": reasons},
            "sources": self.sources,
            "gpus": gpus,
            "models": models,
            "gateway": gateway,
            "host": host,
            "services": services,
            "targets": targets,
            "alerts": {"firing": firing, "pending": pending},
            "backup": backup,
            "hypervisor": hypervisor,
            "spark": {
                **{f"gpu{g['index']}": g["util"] for g in gpus},
                "gpu_gaming": hypervisor["gpu"]["util"] if hypervisor["gpu"] else None,
                "rpm": gateway["rpm"],
                "tps": _r(scalar(f.get("tps_total")), 2),
                "cpu": host["cpu_pct"],
            },
        }

    async def publish(self) -> None:
        self.seq += 1
        snap = self.build()
        self.snapshot = snap
        self.snapshot_bytes = json.dumps(snap, separators=(",", ":")).encode()
        async with self.cond:
            self.cond.notify_all()

    async def run(self) -> None:
        last_fast = last_slow = last_hist = -1e9
        while True:
            t0 = time.monotonic()
            try:
                now = time.monotonic()
                do_fast = now - last_fast >= PROM_FAST_S - 0.1
                do_slow = now - last_slow >= SLOW_S - 0.1
                today = max(60, int((datetime.now(TZ) - local_midnight()).total_seconds()))
                slow_q = {k: v.replace("{today}", str(today)) for k, v in SLOW_QUERIES.items()}

                async def nothing():
                    return None

                res = await asyncio.gather(
                    self.refresh_running(),
                    self.prom_batch(FAST_QUERIES) if do_fast else nothing(),
                    self.prom_batch(slow_q) if do_slow else nothing(),
                    self.refresh_alerts() if do_slow else nothing(),
                    return_exceptions=True,
                )
                if do_fast and isinstance(res[1], dict):
                    self.fast, last_fast = res[1], now
                if do_slow:
                    if isinstance(res[2], dict):
                        self.slow = res[2]
                    self.refresh_backup()
                    last_slow = now
                if now - last_hist >= HIST_S:
                    try:
                        await self.refresh_history()
                        last_hist = now
                    except Exception as e:  # noqa: BLE001
                        log.warning("history refresh failed: %s", type(e).__name__)
                await self.publish()
            except asyncio.CancelledError:
                raise
            except Exception:  # noqa: BLE001
                log.exception("collector cycle failed")
            await asyncio.sleep(max(0.2, FAST_S - (time.monotonic() - t0)))


def local_midnight() -> datetime:
    n = datetime.now(TZ)
    return n.replace(hour=0, minute=0, second=0, microsecond=0)


def pcie_link(bus_id: str) -> dict | None:
    """Read the PCIe link from sysfs (not exported by DCGM on GeForce). bus id 00000000:05:00.0 -> 0000:05:00.0"""
    if not bus_id:
        return None
    dev = Path("/sys/bus/pci/devices") / bus_id[-12:].lower()
    try:
        rd = lambda n: (dev / n).read_text().strip()  # noqa: E731
        cur_w, max_w = int(rd("current_link_width")), int(rd("max_link_width"))
        cur_s, max_s = rd("current_link_speed"), rd("max_link_speed")
    except (OSError, ValueError):
        return None
    gen = {"2.5": 1, "5.0": 2, "8.0": 3, "16.0": 4, "32.0": 5}
    g = lambda s: gen.get(s.split()[0])  # noqa: E731
    return {"width": cur_w, "max_width": max_w, "gen": g(cur_s), "max_gen": g(max_s), "speed": cur_s.split(" PCIe")[0]}


def parse_expected_widths(spec: str | None) -> dict:
    """"8" -> {"*": 8}; "0=16,1=8" -> {0: 16, 1: 8}. Empty, malformed or unrendered -> {} (no warnings)."""
    out: dict = {}
    for part in (spec or "").split(","):
        part = part.strip()
        k, sep, v = part.rpartition("=")
        if not v.isdigit() or int(v) <= 0:
            continue
        if not sep:
            out["*"] = int(v)
        elif k.strip().isdigit():
            out[int(k)] = int(v)
    return out


def expected_width(index: int, widths: dict) -> int | None:
    return widths.get(index, widths.get("*"))


def pcie_describe(link: dict | None, expected: int | None = None) -> dict | None:
    """Add a display label to a pcie_link() dict. The UI shows `label`, styles by `level`, tooltips `title`.

    level: "ok" (nothing to say), "info" (neutral note, e.g. an idle link-speed downshift or a link
    narrower than the card's maximum) or "warn" (width below the configured expectation). Nothing is
    inferred about the slot: the server only knows what sysfs reports.
    """
    if not link:
        return None
    w, mw, gen, mg = link.get("width"), link.get("max_width"), link.get("gen"), link.get("max_gen")
    label = f"PCIe {f'Gen{gen} ' if gen else ''}x{w}"
    title = f"Link: {link.get('speed') or '?'} x{w} (device max {f'Gen{mg} ' if mg else ''}x{mw})."
    level = "ok"
    if gen and mg and gen < mg:
        level = "info"
        label += " · power-save"
        title += f" Running Gen{gen} of Gen{mg}: GPUs drop link speed at idle to save power and go back up under load. Normal."
    if w and mw and w < mw:
        title += f" Link is x{w} of a possible x{mw}"
        title += f"; x{expected} is expected here." if expected is not None and w >= expected else "."
    if expected is not None and w is not None and w < expected:
        level = "warn"
        label += f" · below x{expected}"
        title += f" Width x{w} is below the expected x{expected} (TELEMETRY_GPU_EXPECTED_WIDTH): check the card's seating, riser and slot settings."
    return {**link, "expected_width": expected, "label": label, "level": level, "title": title}


# ---------------------------------------------------------------------------------------------
# Hypervisor / gaming VM (gaming-exporter). Label values originate partly in the gaming guest, so
# every string is allow-listed or sanitised here; numbers go through _num(). A missing series is
# None (the exporter omits guest metrics while the guest is down), never 0.
# ---------------------------------------------------------------------------------------------
HV_MODES = ("ai", "split", "restoring")   # restoring: ai-mode is (or was, if it failed) putting Walter back
HV_PHASES = ("none", "judge-paused", "walter-shutdown", "walter-reconfig", "walter-start", "gaming-start", "done")
HV_DIRECTIONS = ("to-game", "to-ai")
HV_VM_STATES = ("running", "idle", "paused", "in shutdown", "shut off", "crashed", "pmsuspended", "blocked", "missing")
HV_GIB = 1024**3


def _hv_val(x):
    try:
        return _num(x["value"][1])
    except (KeyError, IndexError, TypeError):
        return None


def _hv_labels(x) -> dict:
    m = x.get("metric") if isinstance(x, dict) else None
    return m if isinstance(m, dict) else {}


def _hv_series(res) -> list:
    return [x for x in res if isinstance(x, dict)] if isinstance(res, list) else []


def _hv_active_label(res, label: str, allowed) -> str | None:
    """The single allow-listed label value whose series is 1. None if missing, ambiguous or not allowed."""
    vals = [_hv_labels(x).get(label) for x in _hv_series(res) if _hv_val(x) == 1]
    vals = {v for v in vals if isinstance(v, str) and v in allowed}
    return vals.pop() if len(vals) == 1 else None


def _hv_scalar(res):
    """First sample of a single-series result; None when the series is absent or not a finite number."""
    s = _hv_series(res)
    return _hv_val(s[0]) if s else None


def _hv_bool(res):
    v = _hv_scalar(res)
    return None if v is None else v == 1


def _hv_name(v) -> str:
    v = re.sub(r"[^A-Za-z0-9 ._-]", "", str(v or ""))[:64].strip()
    return v or "GPU"


def _hv_gib(v):
    return None if v is None else round(v / HV_GIB, 2)


def _hv_pcie(gen, width) -> dict | None:
    """The gaming GPU's link chip, from what the guest reports (gen/width only: no sysfs, no max values,
    no width expectation since the guest's view of the passthrough link is all we have)."""
    gen = int(gen) if gen is not None and 1 <= gen <= 7 else None
    width = int(width) if width is not None and 1 <= width <= 32 else None
    if width is None:
        return None
    d = pcie_describe({"width": width, "max_width": None, "gen": gen, "max_gen": None, "speed": None}, None)
    level = "muted" if d["level"] == "info" else d["level"]
    title = f"Link: {f'Gen{gen} ' if gen else ''}x{width}, as reported by the driver inside the gaming VM."
    return {"label": d["label"], "level": level, "title": title}


def hypervisor_view(r: dict) -> dict:
    """Build snapshot["hypervisor"] from the raw hv_* PromQL results (pure: no I/O, never raises on bad data)."""
    r = r if isinstance(r, dict) else {}
    up = _hv_bool(r.get("hv_up")) is True
    view = {"up": up, "mode": "unknown", "direction": None, "phase": None, "since": None,
            "label": "MODE UNKNOWN", "host_cpus": None, "vm": None, "gpu": None}
    if not up:
        view["label"] = "HYPERVISOR OFFLINE"
        return view

    state = _hv_active_label(r.get("hv_mode_state"), "mode", HV_MODES)
    phase = _hv_active_label(r.get("hv_mode_phase"), "phase", HV_PHASES)
    active = [x for x in _hv_series(r.get("hv_switch")) if _hv_val(x) == 1]
    direction = _hv_active_label(active, "direction", HV_DIRECTIONS)

    # Rules from the contract; a missing/garbled state series while the exporter is up (partial
    # Prometheus failure) is reported as "unknown" rather than guessed as "ai".
    if active or state == "restoring" or (state == "split" and phase != "done"):
        mode = "switching"
    elif state is None:
        mode = "unknown"
    elif state == "split":
        mode = "game"
    else:
        mode = "ai"
    view["mode"] = mode

    if mode == "switching":
        view["direction"] = direction or ("to-ai" if state == "restoring" else None)
        view["phase"] = phase if phase not in (None, "none", "done") else None
        arrow = {"to-game": " → GAME", "to-ai": " → AI"}.get(view["direction"], "")
        view["label"] = f"SWITCHING{arrow}" + (f" · {view['phase']}" if view["phase"] else "")
    else:
        view["label"] = {"ai": "AI MODE", "game": "GAME MODE"}.get(mode, "MODE UNKNOWN")

    since = _hv_scalar(r.get("hv_mode_since"))
    if mode in ("game", "switching") and since is not None and 0 < since < time.time() + 300:
        view["since"] = round(since, 3)

    for x in _hv_series(r.get("hv_host_cpus")):
        cpus = str(_hv_labels(x).get("cpus", ""))
        if _hv_labels(x).get("slice") == "system.slice" and re.fullmatch(r"[0-9,-]{1,64}", cpus):
            view["host_cpus"] = cpus
            break

    # VM (libvirt, host side): present while the exporter sees the domain
    running = _hv_bool(r.get("hv_vm_running"))
    vm_state = None
    for x in _hv_series(r.get("hv_vm_state")):
        if _hv_val(x) == 1:
            st = _hv_labels(x).get("state")
            vm_state = st if st in HV_VM_STATES else "unknown"
            break
    guest_up = _hv_bool(r.get("hv_guest_up")) is True
    if running is not None or vm_state is not None:
        vcpus = _hv_scalar(r.get("hv_vm_vcpus"))
        vcpus = int(vcpus) if vcpus is not None and 0 < vcpus <= 1024 else None
        cpu = _hv_scalar(r.get("hv_vm_cpu"))
        cpu_pct = None
        if cpu is not None and vcpus:
            cpu_pct = round(min(100.0, max(0.0, 100.0 * cpu / vcpus)), 1)

        def rate(k):
            v = _hv_scalar(r.get(k))
            return None if v is None else round(max(0.0, v))

        view["vm"] = {
            "state": vm_state or ("running" if running else "unknown"),
            "running": running is True,
            "vcpus": vcpus,
            "cpu_pct": cpu_pct,
            "mem_gib": _hv_gib(_hv_scalar(r.get("hv_vm_mem"))),
            "disk_read_bps": rate("hv_vm_disk_r"),
            "disk_write_bps": rate("hv_vm_disk_w"),
            "net_rx_bps": rate("hv_vm_net_rx"),
            "net_tx_bps": rate("hv_vm_net_tx"),
            "guest_up": guest_up,
            "sunshine": _hv_bool(r.get("hv_sunshine")) if guest_up else None,
            "streaming": _hv_bool(r.get("hv_stream")) if guest_up else None,
        }

    # GPU (reported by the guest): only while the guest is up and the GPU series exist
    util = _hv_scalar(r.get("hv_gpu_util"))
    info = [x for x in _hv_series(r.get("hv_gpu_info")) if _hv_val(x) == 1]
    if guest_up and (info or util is not None):
        f = lambda k, nd=1: _r(_hv_scalar(r.get(k)), nd)  # noqa: E731
        view["gpu"] = {
            "name": _hv_name(_hv_labels(info[0]).get("name") if info else None),
            "util": _r(util, 1),
            "enc_util": f("hv_gpu_enc"),
            "mem_used_gib": _hv_gib(_hv_scalar(r.get("hv_gpu_mem_used"))),
            "mem_total_gib": _hv_gib(_hv_scalar(r.get("hv_gpu_mem_total"))),
            "temp": f("hv_gpu_temp"),
            "power": f("hv_gpu_power"),
            "power_limit": f("hv_gpu_power_limit"),
            "sm_clock": f("hv_gpu_sm_clock", 0),
            "fan": f("hv_gpu_fan"),
            "pcie": _hv_pcie(_hv_scalar(r.get("hv_gpu_pcie_gen")), _hv_scalar(r.get("hv_gpu_pcie_width"))),
        }
    return view


EXPECTED_WIDTHS = parse_expected_widths(GPU_EXPECTED_WIDTH)

collector = Collector()


def clean_header(v: str | None) -> str | None:
    """Display-only. The edge sets these; we never use them for authorization."""
    if not v:
        return None
    v = re.sub(r"[^\w.@+\- ]", "", v)[:96]
    return v or None


# ---------------------------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------------------------
SEC_HEADERS = {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer",
    "X-Frame-Options": "DENY",
    "Content-Security-Policy": (
        "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; "
        "connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
    ),
}


def viewer(request: Request) -> dict:
    return {
        "user": clean_header(request.headers.get("x-forwarded-user")),
        "email": clean_header(request.headers.get("x-forwarded-email")),
    }


async def index(request: Request) -> Response:
    return FileResponse(STATIC / "index.html", headers={**SEC_HEADERS, "Cache-Control": "no-cache"})


async def healthz(request: Request) -> Response:
    return PlainTextResponse("ok")


async def telemetry(request: Request) -> Response:
    body = (
        b'{"viewer":'
        + json.dumps(viewer(request)).encode()
        + b',"history":'
        + collector.history_bytes
        + b',"snapshot":'
        + collector.snapshot_bytes
        + b"}"
    )
    return Response(body, media_type="application/json", headers={"Cache-Control": "no-store", **SEC_HEADERS})


async def stream(request: Request) -> Response:
    if collector.sse_clients >= MAX_SSE:
        return PlainTextResponse("too many streams", status_code=503)

    async def gen():
        collector.sse_clients += 1
        try:
            yield b"retry: 3000\n\n"
            seen = -1
            last_hb = time.monotonic()
            while True:
                if collector.seq != seen and collector.snapshot:
                    seen = collector.seq
                    yield b"event: snapshot\ndata: " + collector.snapshot_bytes + b"\n\n"
                timeout = max(0.1, HEARTBEAT_S - (time.monotonic() - last_hb))
                try:
                    async with collector.cond:
                        await asyncio.wait_for(collector.cond.wait(), timeout=timeout)
                except asyncio.TimeoutError:
                    pass
                if time.monotonic() - last_hb >= HEARTBEAT_S:
                    last_hb = time.monotonic()
                    yield b": hb\n\n"
        finally:
            collector.sse_clients -= 1

    return StreamingResponse(
        gen(),
        media_type="text/event-stream",
        headers={"Cache-Control": "no-cache, no-transform", "X-Accel-Buffering": "no", "X-Content-Type-Options": "nosniff"},
    )


class StaticWithHeaders(StaticFiles):
    async def get_response(self, path, scope):
        resp = await super().get_response(path, scope)
        resp.headers.update(SEC_HEADERS)
        if path.startswith("fonts/"):
            resp.headers["Cache-Control"] = "public, max-age=604800, immutable"
        else:
            resp.headers["Cache-Control"] = "no-cache"
        return resp


@asynccontextmanager
async def lifespan(app):
    task = asyncio.create_task(collector.run())
    try:
        yield
    finally:
        task.cancel()
        await collector.client.aclose()


app = Starlette(
    routes=[
        Route("/", index),
        Route("/healthz", healthz),
        Route("/api/v1/telemetry", telemetry),
        Route("/api/v1/stream", stream),
        Mount("/static", StaticWithHeaders(directory=STATIC), name="static"),
    ],
    lifespan=lifespan,
)


def make_socket(addr: str) -> socket.socket:
    host, port = addr.rsplit(":", 1)
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    # IP_FREEBIND: bind ${BACKEND_WG_IP} even if wg0 isn't up yet at boot
    s.setsockopt(socket.IPPROTO_IP, getattr(socket, "IP_FREEBIND", 15), 1)
    s.bind((host, int(port)))
    s.set_inheritable(True)
    return s


def main() -> None:
    logging.basicConfig(level=os.environ.get("LOG_LEVEL", "INFO"), format="%(asctime)s %(levelname)s %(name)s %(message)s")
    logging.getLogger("httpx").setLevel(logging.WARNING)
    socks = [make_socket(a.strip()) for a in BIND.split(",") if a.strip()]
    config = uvicorn.Config(
        app,
        log_level="warning",
        access_log=False,
        proxy_headers=False,
        server_header=False,
        timeout_graceful_shutdown=3,
    )
    server = uvicorn.Server(config)
    asyncio.run(server.serve(sockets=socks))


if __name__ == "__main__":
    main()
