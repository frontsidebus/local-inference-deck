    "m_decode_tps": "rate(llamacpp:tokens_predicted_total[10m]) / rate(llamacpp:tokens_predicted_seconds_total[10m]) > 0",
    "m_prompt_tps": "rate(llamacpp:prompt_tokens_total[10m]) / rate(llamacpp:prompt_seconds_total[10m]) > 0",
