INTERVAL = 5.0                    # seconds between collections (Walter scrapes every 5 s)
STALE_AFTER = 30.0                # /healthz fails once the last collection is older than this
GDOM = "linux-gaming"
VIRSH = ["virsh", "-q", "-c", "qemu:///system"]
HOME = os.path.expanduser("~")
STATE = os.path.join(HOME, ".local/state/gpu-mode")
LOCK = STATE + ".lock"
SLICES = ("system.slice", "user.slice", "init.scope")
GUEST_OUT_MAX = 16 * 1024         # bytes read from the guest per poll; more is a failed poll
GUEST_LINES_MAX = 32
GUEST_LINE_MAX = 512
IP_FREEBIND = getattr(socket, "IP_FREEBIND", 15)   # linux/in.h; Python's socket module lacks the name

# nvidia-smi --query-gpu fields, in order: (metric suffix or None for the name, multiplier, low, high).
# A value outside [low, high] is dropped like [N/A]: a broken or hostile guest cannot inject odd numbers.
GPU_FIELDS = [
    ("name", None, None, None),
    ("utilization.gpu", "utilization_percent", 1, (0, 100)),
    ("utilization.encoder", "encoder_utilization_percent", 1, (0, 100)),
    ("memory.used", "memory_used_bytes", 1048576, (0, 1 << 22)),       # MiB, up to 4 TiB
    ("memory.total", "memory_total_bytes", 1048576, (0, 1 << 22)),
    ("temperature.gpu", "temperature_celsius", 1, (-40, 150)),
    ("power.draw", "power_watts", 1, (0, 5000)),
    ("power.limit", "power_limit_watts", 1, (0, 5000)),
    ("clocks.sm", "sm_clock_mhz", 1, (0, 20000)),
    ("fan.speed", "fan_percent", 1, (0, 100)),
    ("pcie.link.gen.current", "pcie_link_gen", 1, (1, 16)),
    ("pcie.link.width.current", "pcie_link_width", 1, (1, 64)),
]
NUM_RE = re.compile(r"-?[0-9]{1,9}(?:\.[0-9]{1,6})?")
NAME_BAD = re.compile(r"[^A-Za-z0-9 ._-]")
WORD_RE = re.compile(r"[a-z][a-z0-9-]{0,31}")
CPUS_RE = re.compile(r"[0-9][0-9,-]{0,63}")
PHASES = ("none", "judge-paused", "walter-shutdown", "walter-reconfig", "walter-start", "gaming-start", "done")
DIRECTIONS = ("to-game", "to-ai", "unknown")
# virsh domstats state.state (virDomainState) -> the words `virsh domstate` prints
DOM_STATES = {0: "no state", 1: "running", 2: "idle", 3: "paused", 4: "in shutdown", 5: "shut off",
              6: "crashed", 7: "pmsuspended"}


def log(msg):
    print(msg, file=sys.stderr, flush=True)


# ------------------------------------------------------------------------------------------ site values
def site_value(text, key, default=""):
    """gpu-mode's site(): the last KEY= line, a trailing ' # comment' and all quotes removed."""
    val = None
    for line in text.splitlines():
        if line.startswith(key + "="):
            val = line[len(key) + 1:]
    if val is None:
        return default
    val = re.sub(r"\s+#.*$", "", val).replace('"', "").replace("'", "")
    return val or default


def read_site(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read(1 << 20)
    except OSError:
        return ""


def guest_ip(subnet):
    if not re.fullmatch(r"[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}", subnet or ""):
        raise ValueError("GAMING_SUBNET must be three octets, e.g. 192.168.150")
    return str(ipaddress.IPv4Address(subnet + ".10"))


def parse_bind(spec):
    """'ADDR:PORT' -> (addr, port); IPv4 and a specific address only (never 0.0.0.0)."""
    addr, sep, port = (spec or "").rpartition(":")
    if not sep or not port.isdigit() or not 0 < int(port) < 65536:
        raise ValueError("bind address must be ADDR:PORT, got %r" % spec)
    ip = ipaddress.IPv4Address(addr)
    if ip.is_unspecified:
        raise ValueError("refusing to listen on every address; give a specific one")
    return str(ip), int(port)


# ------------------------------------------------------------------------------------------ parsers
def parse_number(text, lo, hi):
    """A strictly formatted number within [lo, hi], else None ([N/A], [Not Supported], garbage)."""
    text = text.strip()
    if not NUM_RE.fullmatch(text):
        return None
    v = float(text)
    return v if lo <= v <= hi else None


def sanitize_name(text):
    return NAME_BAD.sub("", text).strip()[:64].strip()


def parse_nvidia_smi(text):
    """The first well-formed line of the query in GPU_FIELDS -> {"name": str, suffix: number, ...}.
    A line with the wrong number of fields is skipped whole (a comma in the name can't shift values)."""
    for line in text.splitlines()[:4]:
        parts = line.split(",")
        if len(parts) != len(GPU_FIELDS):
            continue
        out = {}
        name = sanitize_name(parts[0])
        if name:
            out["name"] = name
        for (_, suffix, mult, rng), raw in zip(GPU_FIELDS[1:], parts[1:]):
            v = parse_number(raw, *rng)
            if v is not None:
                out[suffix] = v * mult
        return out
    return None


def parse_guest(text):
    """The guest script's output (sections @gpu, @sunshine, @stream, @end) -> dict, or None if the
    output is not what the script prints (no @end: cut short or not ours)."""
    lines = text.splitlines()
    if len(lines) > GUEST_LINES_MAX or any(len(x) > GUEST_LINE_MAX for x in lines):
        return None
    sec, body = None, {}
    for line in lines:
        if line in ("@gpu", "@sunshine", "@stream", "@end"):
            sec = line[1:]
            if sec in body:
                return None
            body[sec] = []
        elif sec is not None:
            body[sec].append(line)
    if "end" not in body or body["end"]:
        return None
    out = {"gpu": parse_nvidia_smi("\n".join(body.get("gpu", []))), "sunshine": None, "stream": None}
    for k in ("sunshine", "stream"):
        if body.get(k) in (["0"], ["1"]):
            out[k] = body[k][0] == "1"
    if out["sunshine"] is False:
        out["stream"] = False if out["stream"] is not None else None
    return out


def parse_domstats(text):
    """`virsh domstats --raw` for one domain -> {"state", "vcpus", "cpu_seconds", "memory_bytes",
    "disk_read", "disk_write", "net_rx", "net_tx"} (keys present only when virsh printed them)."""
    kv = {}
    for line in text.splitlines():
        k, sep, v = line.strip().partition("=")
        if sep and re.fullmatch(r"[a-z0-9._-]{1,64}", k) and re.fullmatch(r"[0-9]{1,20}", v):
            kv[k] = int(v)
    out = {}
    if "state.state" in kv:
        out["state"] = DOM_STATES.get(kv["state.state"], "unknown")
    if "vcpu.current" in kv:
        out["vcpus"] = kv["vcpu.current"]
    if "cpu.time" in kv:
        out["cpu_seconds"] = kv["cpu.time"] / 1e9
    mem = kv.get("balloon.current", kv.get("balloon.maximum"))
    if mem is not None:
        out["memory_bytes"] = mem * 1024
    for prefix, key, field in (("block", "disk_read", "rd.bytes"), ("block", "disk_write", "wr.bytes"),
                               ("net", "net_rx", "rx.bytes"), ("net", "net_tx", "tx.bytes")):
        n = kv.get(prefix + ".count")
        if n is not None:
            out[key] = sum(kv.get("%s.%d.%s" % (prefix, i, field), 0) for i in range(min(n, 64)))
    return out


def parse_state_file(text):
    """gpu-mode's state file (None = absent: AI mode) -> {"mode", "phase", "since"}."""
    if text is None:
        return {"mode": "ai", "phase": "none", "since": None}
    kv = {}
    for line in text.splitlines()[:16]:
        k, sep, v = line.partition("=")
        if sep:
            kv[k.strip()] = v.strip()
    mode = kv.get("mode", "")
    phase = kv.get("phase", "") or "none"
    since = None
    raw = kv.get("since", "")
    if re.fullmatch(r"[0-9T:+.-]{1,40}", raw):
        try:
            if raw.isdigit():
                since = float(raw)
            else:
                d = datetime.datetime.fromisoformat(raw)
                since = d.timestamp() if d.tzinfo else None
        except (ValueError, OverflowError):
            since = None
    return {"mode": mode if WORD_RE.fullmatch(mode) else "unknown",
            "phase": phase if phase in PHASES or WORD_RE.fullmatch(phase) else "unknown",
            "since": since}


def lock_held(locks_text, dev, ino):
    """Whether /proc/locks shows a flock() held on the file with this st_dev/st_ino. Reading /proc/locks
    is passive: taking the lock ourselves, even for an instant, could make a game-mode starting at that
    moment fail its `flock -n` ("another game-mode/ai-mode is running")."""
    want = "%02x:%02x:%d" % (os.major(dev), os.minor(dev), ino)
    for line in locks_text.splitlines():
        f = line.split()
        if len(f) >= 6 and f[1] == "FLOCK" and f[5] == want:   # holders; waiters have "->" in f[1]
            return True
    return False


SWITCH_NAMES = ("gpu-mode", "game-mode", "ai-mode")
SHELLS = ("bash", "sh", "dash")


def switch_direction(argv):
    """argv of a process -> "to-game"/"to-ai" when it is a gpu-mode switch, else None. Mirrors gpu-mode's
    argument handling: the last of game|ai|status|check wins, otherwise the name decides."""
    if not argv:
        return None
    i = 0
    if os.path.basename(argv[0]) in SHELLS:
        i = 1
        while i < len(argv) and argv[i].startswith("-"):
            i += 1
    if i >= len(argv):
        return None
    name = os.path.basename(argv[i])
    if name not in SWITCH_NAMES:
        return None
    cmd = {"game-mode": "game", "ai-mode": "ai"}.get(name)
    for a in argv[i + 1:]:
        if a in ("-h", "--help"):
            return None
        if a in ("game", "ai", "status", "check"):
            cmd = a
    return {"game": "to-game", "ai": "to-ai"}.get(cmd)


def scan_switches(proc="/proc"):
    found = []
    me = os.getpid()
    for pid in os.listdir(proc):
        if not pid.isdigit() or int(pid) == me:
            continue
        try:
            with open(os.path.join(proc, pid, "cmdline"), "rb") as f:
                raw = f.read(4096)
        except OSError:
            continue
        d = switch_direction([a.decode("utf-8", "replace") for a in raw.split(b"\0") if a])
        if d:
            found.append(d)
    return found


