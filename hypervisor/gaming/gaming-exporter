def escape_label(v):
    return str(v).replace("\\", "\\\\").replace("\n", "\\n").replace('"', '\\"')


def fmt_value(v):
    if isinstance(v, bool):
        return "1" if v else "0"
    if isinstance(v, int) or (isinstance(v, float) and v.is_integer() and abs(v) < 1e15):
        return str(int(v))
    return repr(float(v))


def render(samples):
    """[(name, {label: value}, number)] -> Prometheus text format 0.0.4, families in FAMILIES order."""
    by = {}
    for name, labels, value in samples:
        if name not in FAMILIES:
            raise KeyError(name)
        by.setdefault(name, []).append((labels, value))
    out = []
    for name, (typ, hlp) in FAMILIES.items():
        if name not in by:
            continue
        out.append("# HELP %s %s" % (name, hlp))
        out.append("# TYPE %s %s" % (name, typ))
        for labels, value in by[name]:
            lab = ",".join('%s="%s"' % (k, escape_label(v)) for k, v in labels.items())
            out.append("%s%s %s" % (name, "{%s}" % lab if lab else "", fmt_value(value)))
    return "\n".join(out) + "\n"


# ------------------------------------------------------------------------------------------ commands
def run_bounded(argv, timeout, limit=1 << 18):
    """Runs argv without a shell; returns (rc, stdout, stderr) as text. Output past `limit` bytes or a
    run past `timeout` kills it and gives rc None, so nothing (a hostile guest least of all) can make us
    buffer without bound or hang the collector."""
    try:
        p = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                             close_fds=True, start_new_session=True)
    except OSError as e:
        return None, "", str(e)
    bufs = {p.stdout: bytearray(), p.stderr: bytearray()}
    sel = selectors.DefaultSelector()
    for f in bufs:
        sel.register(f, selectors.EVENT_READ)
    end, over = time.monotonic() + timeout, False
    try:
        while sel.get_map():
            left = end - time.monotonic()
            if left <= 0:
                over = True
                break
            for key, _ in sel.select(left):
                chunk = os.read(key.fd, 65536)
                if not chunk:
                    sel.unregister(key.fileobj)
                    continue
                b = bufs[key.fileobj]
                b += chunk
                if len(b) > limit:
                    over = True
                    break
            if over:
                break
    finally:
        sel.close()
        if over:
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except OSError:
                pass
        try:
            rc = p.wait(timeout=2)
        except subprocess.TimeoutExpired:
            p.kill()
            rc = p.wait()
        p.stdout.close()
        p.stderr.close()
    if over:
        rc = None
    return rc, bufs[p.stdout].decode("utf-8", "replace"), bufs[p.stderr].decode("utf-8", "replace")


def guest_script(sunshine_port):
    """The one command run in the guest per poll (POSIX sh, read-only).

    Stream check: Sunshine binds its video (base+9), control (base+10, ENet) and audio (base+11) UDP
    sockets in start_broadcast() when the first session starts, and closes them in end_broadcast() when
    the last session ends (src/stream.cpp: a ref-counted broadcast context each session holds). So a UDP
    socket on the video port exists only while a client streams. Socket *state* would not work: those
    UDP sockets are never connect()ed (always UNCONN), and the TCP ports (HTTPS, HTTP, RTSP) are only
    used to set the session up. ss failing or missing prints nothing, and the metric is then omitted."""
    q = ",".join(f for f, *_ in GPU_FIELDS)
    video = int(sunshine_port) + 9
    return ("printf '@gpu\\n'; timeout 5 nvidia-smi --query-gpu=%s --format=csv,noheader,nounits 2>/dev/null | head -n 4; "
            "printf '@sunshine\\n'; if pgrep -x sunshine >/dev/null 2>&1; then echo 1; else echo 0; fi; "
            "printf '@stream\\n'; if s=$(ss -Huan 'sport = :%d' 2>/dev/null); then "
            "if [ -n \"$s\" ]; then echo 1; else echo 0; fi; fi; "
            "printf '@end\\n'" % (q, video))


class Guest:
    """ssh into the guest through a persistent master connection, so polling every 5 s reuses one TCP/ssh
    session. The control socket lives in a private 0700 directory under $XDG_RUNTIME_DIR."""

    def __init__(self, host, user, key, ctl_dir, sunshine_port):
        self.dest = "%s@%s" % (user, host) if user else host
        self.ctl_dir = ctl_dir
        self.ctl = os.path.join(ctl_dir, "cm")
        self.script = guest_script(sunshine_port)
        self.opts = ["-i", key, "-o", "IdentitiesOnly=yes", "-o", "ForwardAgent=no", "-o", "ForwardX11=no",
                     "-o", "ClearAllForwardings=yes", "-o", "PermitLocalCommand=no", "-o", "BatchMode=yes",
                     "-o", "ConnectTimeout=3", "-o", "ServerAliveInterval=5", "-o", "ServerAliveCountMax=2",
                     "-o", "LogLevel=ERROR", "-o", "ControlPath=" + self.ctl]

    def _private_dir(self):
        os.makedirs(self.ctl_dir, mode=0o700, exist_ok=True)
        st = os.lstat(self.ctl_dir)
        if not os.path.isdir(self.ctl_dir) or os.path.islink(self.ctl_dir) or st.st_uid != os.getuid() \
                or st.st_mode & 0o077:
            raise RuntimeError("%s must be a directory of ours with mode 0700" % self.ctl_dir)

    def _master_alive(self):
        if not os.path.exists(self.ctl):
            return False
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(1)
        try:
            s.connect(self.ctl)
            return True
        except OSError:
            try:
                os.unlink(self.ctl)      # stale socket from a master that died
            except OSError:
                pass
            return False
        finally:
            s.close()

    def _start_master(self):
        # -f -N: ssh authenticates, then backgrounds itself with stdio on /dev/null (so it never holds our
        # pipes). ControlPersist ends it 2 min after the last poll; the unit's cgroup ends it on stop.
        try:
            subprocess.run(["ssh", *self.opts, "-o", "ControlMaster=yes", "-o", "ControlPersist=120", "-f", "-N",
                            self.dest], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=10, check=False)
        except (OSError, subprocess.TimeoutExpired):
            pass

    def poll(self):
        """-> parsed guest dict, or None on any failure."""
        self._private_dir()
        if not self._master_alive():
            self._start_master()
        # ControlMaster=no: use the master if it is there, else a plain one-off connection.
        rc, out, _ = run_bounded(["ssh", *self.opts, "-o", "ControlMaster=no", "-T", self.dest, self.script],
                                 timeout=10, limit=GUEST_OUT_MAX)
        if rc != 0:
            return None
        return parse_guest(out)

    def close(self):
        if os.path.exists(self.ctl):
            run_bounded(["ssh", *self.opts, "-O", "exit", self.dest], timeout=3, limit=4096)


# ------------------------------------------------------------------------------------------ collector
def read_text(path, limit=65536):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read(limit)
    except FileNotFoundError:
        return None


class Collector:
    def __init__(self, guest, state=STATE, lock=LOCK, cgroup="/sys/fs/cgroup"):
        self.guest, self.state, self.lock, self.cgroup = guest, state, lock, cgroup
        self.text = render([("hv_exporter_build_info", {"version": VERSION}, 1)])
        self.updated = 0.0
        self.stop = threading.Event()
        self._last_err = {}

    def _err(self, part, e):
        msg = "%s: %s" % (part, e)
        if self._last_err.get(part) != msg:       # log changes only, not every 5 s
            log("collect " + msg)
            self._last_err[part] = msg

    def _ok(self, part):
        if self._last_err.pop(part, None):
            log("collect %s: ok again" % part)

    def gpu_mode(self, s):
        st = parse_state_file(read_text(self.state, 4096))
        s.append(("hv_gpu_mode_state", {"mode": st["mode"]}, 1))
        s.append(("hv_gpu_mode_phase", {"phase": st["phase"]}, 1))
        if st["since"] is not None:
            s.append(("hv_gpu_mode_since_seconds", {}, st["since"]))
        held = False
        try:
            sb = os.stat(self.lock)               # never created here: gpu-mode creates it
            held = lock_held(read_text("/proc/locks", 1 << 20) or "", sb.st_dev, sb.st_ino)
        except FileNotFoundError:
            pass
        dirs = scan_switches()
        active = "to-game" if "to-game" in dirs else "to-ai" if "to-ai" in dirs else "unknown" if held else None
        for d in DIRECTIONS:
            s.append(("hv_gpu_mode_switch_active", {"direction": d}, int(d == active)))

    def host_cpus(self, s):
        for u in SLICES:
            v = (read_text(os.path.join(self.cgroup, u, "cpuset.cpus.effective"), 256) or "").strip()
            if CPUS_RE.fullmatch(v):
                s.append(("hv_host_allowed_cpus", {"slice": u, "cpus": v}, 1))

    def vm(self, s):
        rc, out, err = run_bounded([*VIRSH, "domstats", GDOM, "--raw", "--state", "--cpu-total", "--balloon",
                                    "--vcpu", "--interface", "--block"], timeout=10, limit=1 << 20)
        if rc == 0:
            d = parse_domstats(out)
            state = d.get("state", "unknown")
        else:
            d, state = {}, "missing" if "failed to get domain" in err else "unknown"
            if state == "unknown":
                raise RuntimeError("virsh domstats failed: %s" % err.strip()[:200])
        running = state == "running"
        s.append(("hv_gaming_vm_running", {}, int(running)))
        s.append(("hv_gaming_vm_state", {"state": state}, 1))
        if running:
            for key, name in (("vcpus", "hv_gaming_vm_vcpus"), ("cpu_seconds", "hv_gaming_vm_cpu_seconds_total"),
                              ("memory_bytes", "hv_gaming_vm_memory_bytes"),
                              ("disk_read", "hv_gaming_vm_disk_read_bytes_total"),
                              ("disk_write", "hv_gaming_vm_disk_write_bytes_total"),
                              ("net_rx", "hv_gaming_vm_net_rx_bytes_total"),
                              ("net_tx", "hv_gaming_vm_net_tx_bytes_total")):
                if key in d:
                    s.append((name, {}, d[key]))
        return running

    def guest_metrics(self, s, running):
        if not running:
            s.append(("hv_gaming_guest_up", {}, 0))
            return
        t0 = time.monotonic()
        g = self.guest.poll()
        s.append(("hv_gaming_guest_up", {}, int(g is not None)))
        s.append(("hv_gaming_guest_poll_seconds", {}, round(time.monotonic() - t0, 3)))
        if g is None:
            return
        gpu = g["gpu"] or {}
        if "name" in gpu:
            s.append(("hv_gaming_gpu_info", {"name": gpu["name"]}, 1))
        for _, suffix, _, _ in GPU_FIELDS[1:]:
            if suffix in gpu:
                s.append(("hv_gaming_gpu_" + suffix, {}, gpu[suffix]))
        if g["sunshine"] is not None:
            s.append(("hv_gaming_sunshine_running", {}, int(g["sunshine"])))
        if g["stream"] is not None:
            s.append(("hv_gaming_stream_active", {}, int(g["stream"])))

    def collect(self):
        t0 = time.monotonic()
        s = [("hv_exporter_build_info", {"version": VERSION}, 1)]
        for part, fn in (("gpu-mode", self.gpu_mode), ("host-cpus", self.host_cpus)):
            try:
                fn(s)
                self._ok(part)
            except Exception as e:  # noqa: BLE001 - one broken source must not drop the others
                self._err(part, e)
        running = False
        try:
            running = self.vm(s)
            self._ok("vm")
        except Exception as e:  # noqa: BLE001
            self._err("vm", e)
        try:
            self.guest_metrics(s, running)
            self._ok("guest")
        except Exception as e:  # noqa: BLE001
            self._err("guest", e)
        s.append(("hv_exporter_collect_seconds", {}, round(time.monotonic() - t0, 3)))
        self.text = render(s)                     # one reference swap: readers see old or new, never half
        self.updated = time.time()

    def loop(self):
        while not self.stop.is_set():
            t0 = time.monotonic()
            try:
                self.collect()
            except Exception as e:  # noqa: BLE001
                self._err("collect", e)
            self.stop.wait(max(0.5, INTERVAL - (time.monotonic() - t0)))


# ------------------------------------------------------------------------------------------ HTTP
class Handler(BaseHTTPRequestHandler):
    server_version = "gaming-exporter/" + VERSION
    sys_version = ""
    protocol_version = "HTTP/1.0"
    timeout = 10                                  # per-connection socket timeout (slow clients)

    def _send(self, code, body, ctype="text/plain; charset=utf-8", head=False):
        data = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        if not head:
            self.wfile.write(data)

    def _route(self, head):
        c = self.server.collector
        path = self.path.split("?", 1)[0]
        if path == "/metrics":
            self._send(200, c.text, "text/plain; version=0.0.4; charset=utf-8", head)
        elif path == "/healthz":
            fresh = time.time() - c.updated < STALE_AFTER
            self._send(200 if fresh else 503, "ok\n" if fresh else "stale\n", head=head)
        else:
            self._send(404, "not found\n", head=head)

    def do_GET(self):
        self._route(False)

    def do_HEAD(self):
        self._route(True)

    def log_message(self, fmt, *args):
        pass


class Server(ThreadingHTTPServer):
    daemon_threads = True
    request_queue_size = 16

    def server_bind(self):
        # IP_FREEBIND: bind the bridge address even before virbr0 has it. Skip HTTPServer's getfqdn().
        self.socket.setsockopt(socket.SOL_IP, IP_FREEBIND, 1)
        socketserver.TCPServer.server_bind(self)
        self.server_name, self.server_port = self.server_address[:2]


def main():
    site = read_site(os.environ.get("SITE_ENV") or os.path.join(HOME, ".config/deck/site.env"))
    bind = os.environ.get("GAMING_EXPORTER_BIND") or "%s:%d" % (site_value(site, "HYPERVISOR_BRIDGE_IP"), PORT)
    try:
        addr = parse_bind(bind)
        host = guest_ip(site_value(site, "GAMING_SUBNET", "192.168.150"))
        user = os.environ.get("GAMING_GUEST_USER", "")
        if user and not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", user):
            raise ValueError("GAMING_GUEST_USER is not a valid user name")
        port = os.environ.get("GAMING_SUNSHINE_PORT", "47989")
        if not port.isdigit() or not 1024 <= int(port) <= 65000:
            raise ValueError("GAMING_SUNSHINE_PORT must be a port number")
    except ValueError as e:
        log("gaming-exporter: %s (HYPERVISOR_BRIDGE_IP / GAMING_SUBNET in the site env, or the environment)" % e)
        return 2
    run = os.environ.get("RUNTIME_DIRECTORY") or os.path.join(
        os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid(), "gaming-exporter")
    guest = Guest(host, user, os.environ.get("GAMING_GUEST_KEY") or os.path.join(HOME, ".ssh/id_linux_gaming"),
                  run.split(":")[0], int(port))
    collector = Collector(guest)
    srv = Server(addr, Handler)
    srv.collector = collector
    t = threading.Thread(target=collector.loop, name="collector", daemon=True)
    t.start()

    def stop(*_):
        collector.stop.set()
        threading.Thread(target=srv.shutdown, daemon=True).start()
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    log("gaming-exporter %s listening on %s:%d" % (VERSION, *addr))
    try:
        srv.serve_forever(poll_interval=1)
    finally:
        srv.server_close()
        guest.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
