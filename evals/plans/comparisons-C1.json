 },
 "arms": {
  "about": "Approved robustness arms (owner decision 2026-10-11; PROTOCOL C1.13). Subset per sealed suite: C1 pool ids with int(sha256('c1-arm|' + id)[:8], 16) % k == 0, k = max(1, floor(n_pool / 200)) (about 200 items per suite and model), pinned in freeze-C1.json (arms) by make_c1.py freeze. Prospective suites are not in any arm.",
  "not_run": {
   "a": "vendor samplers: not approved; disclosed as a limitation (C1.0, C1.16)",
   "d": "prompt paraphrase: not approved; disclosed as a limitation (C1.16)",
   "e": "sampled thinking-off: served only D7, which is exploratory; not run",
   "f": "contamination probes: not in the 2026-10-11 approval; not run in C1 unless approved by a dated amendment before freeze"
  },
  "rule": "An arm never changes a verdict's direction. It marks a confirmed or equivalence verdict 'not robust to arm X' when, on the arm subset, the arm's estimate falls on the other side of zero (directional) or outside the margin (equivalence) AND its 95% interval excludes the primary's estimate on the same subset. An arm with fewer than min_n items for a comparison is 'not evaluable' for it.",
  "arms": {
   "b": {
    "name": "budget-2x",
    "run_names": {
     "c1": "c1armb",
     "c1sys": "c1sysarmb",
     "c1pre": "c1prearmb"
    },
    "budget_multiplier": 2,
    "change": "every answer_tokens value and think_budget of the frozen BUDGET_POLICY doubled (run.py --budget-policy; the policy and its sha256 are pinned in freeze-C1.json arms.b)",
    "seeds": "thinking off: 1234; thinking on (D2's coder side): seed 1234 only (a single-seed arm)",
    "applies_to": "every confirmatory comparison on a sealed suite (prospective rows excluded)",
    "decision_rule": "the arm rule, per comparison; plus, per model x suite, the 1x and 2x truncation rates and the paired change of the primary metric. A cell whose primary metric improves at 2x by more than the comparison's margin (0.05 for rates without one; 0.3 MAE points) with a 95% interval excluding zero is labelled 'budget-limited', and every verdict that uses it is reported as holding 'at the frozen budget' only."
   },
   "c": {
    "name": "mcq-option-shift",
    "run_names": {
     "c1": "c1armc",
     "c1pre": "c1prearmc"
    },
    "change": "options cyclically shifted by one so every option and the key move (evals/tools/contam_probes.py perm), thinking off, seed 1234",
    "applies_to": [
     "D5.ctibench-mcq",
     "D8.mcq"
    ],
    "decision_rule": "the arm rule, per comparison (A and B both on shifted options vs the primary on the same subset); plus, per model, the paired accuracy change shifted - original (exact McNemar, Newcombe 95% interval) and the stale-letter rate. A model whose interval lies wholly below -0.05 is labelled 'option-order sensitive' and its MCQ results carry that label. Never excludes items."
   }
  }
 },
