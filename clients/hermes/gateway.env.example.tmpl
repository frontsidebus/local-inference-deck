# Lines the optional hermes-gateway needs in ~/.hermes/.env (mode 600).
# ~/.hermes/.env also holds personal Hermes settings, so install.sh never rewrites it:
# with --with-hermes-gateway --force it APPENDS only the names that are missing, and
# generates API_SERVER_KEY with `openssl rand -hex 32`. Otherwise it prints what to add.
#
# Bind to the hypervisor bridge only, so just the backend VM (Open WebUI) can reach it.
API_SERVER_ENABLED=true
API_SERVER_HOST=${HYPERVISOR_BRIDGE_IP}
API_SERVER_PORT=${HERMES_GATEWAY_PORT}
# Bearer key Open WebUI sends; must match the matching OPENAI_API_KEYS entry on the backend.
API_SERVER_KEY=CHANGEME
# Gateway timeouts (cold model loads ~30 s; long generations more).
HERMES_API_TIMEOUT=900
HERMES_API_CALL_STALE_TIMEOUT=900
