#!/usr/bin/env python3
"""deck-tools: keep a repo's vendored tools/deck-tools/ identical to a release (stdlib only).

Usage:
    deck-tools verify [--repo DIR] [--index] [--base REV] [--quiet]
    deck-tools lock [--repo DIR] [--force]
    deck-tools sync --from DIR [--repo DIR] [--allow-dirty]
    deck-tools install-hooks [--repo DIR] [--force]
    deck-tools version

--repo defaults to the repo this file is vendored in (two levels above it).

verify         every file under tools/deck-tools/ must be listed in tools/tools.lock with the same sha256 and mode
               (100755 = executable, 100644 = not), nothing may be missing or unlisted, VERSION must equal the
               lock's version and CHANGELOG.md must have a "## <version>" entry. In a git work tree, the modes git
               records for tracked files must match too. --index checks the staged files and the staged lock
               instead of the work tree (the pre-commit hook uses it). --base REV also fails when the locked
               files differ from the lock at REV but the version did not go up (CI on a pull request).
lock           the origin repo (local-inference-deck) only: rewrite tools/tools.lock from tools/deck-tools/.
               Run it in the same commit as any engine edit, after bumping VERSION and adding a CHANGELOG entry.
               A vendored copy refuses (its lock names a source); change the origin and sync instead.
sync           copy the release in DIR (a local-inference-deck checkout, at a deck-tools-v* tag) into this repo's
               tools/deck-tools/ and rewrite tools/tools.lock. DIR must verify clean against its own lock and
               have no uncommitted changes there (--allow-dirty overrides the latter, and the lock says so).
install-hooks  install a small pre-commit hook in the clone's hooks dir that runs the committing work tree's
               hooks/pre-commit (else tools/deck-tools/pre-commit). An existing different hook is kept unless
               --force (it is then saved as pre-commit.pre-deck-tools).

Exit codes: 0 ok, 1 drift or refused change, 2 usage error or no/invalid lock.
"""
import argparse
import hashlib
import os
import re
import stat
import subprocess
import sys
import tempfile
from pathlib import Path

LOCK_FORMAT = "1"
LOCK_REL = "tools/tools.lock"
TOOLS_REL = "tools/deck-tools"
HOOK_MARKER = "deck-tools-hook-stub v1"
IGNORED_DIRS = {"__pycache__"}
IGNORED_SUFFIXES = (".pyc",)
VERSION_RE = re.compile(r"^(\d+)\.(\d+)\.(\d+)$")
ENTRY_RE = re.compile(r"^(100755|100644) ([0-9a-f]{64}) (\S+)$")

LOCK_HEADER = """\
# tools/tools.lock: GENERATED by tools/deck-tools/deck-tools; do not edit by hand.
# The deck-tools release vendored in this repo: one "<mode> <sha256> <path>" line per file under
# tools/deck-tools/ (mode 100755 = executable, 100644 = not). `tools/deck-tools/deck-tools verify` fails on any
# difference. Update it with `deck-tools lock` in local-inference-deck (source: origin) or with
# `deck-tools sync --from <deck checkout>` in a consumer repo. Format: tools/deck-tools/README.md.
"""

HOOK_STUB = f"""\
#!/usr/bin/env bash
# Installed by `tools/deck-tools/deck-tools install-hooks` ({HOOK_MARKER}). Runs the pre-commit hook of the
# work tree being committed, so each worktree of this clone uses its own copy. Fails closed when there is none.
root=$(git rev-parse --show-toplevel) || exit 1
for h in "$root/hooks/pre-commit" "$root/tools/deck-tools/pre-commit"; do
  if [[ -e $h ]]; then exec "$h" "$@"; fi
done
echo "pre-commit: no hooks/pre-commit or tools/deck-tools/pre-commit in $root; commit blocked" >&2
exit 1
"""


class Fail(Exception):
    def __init__(self, msg, rc=1):
        super().__init__(msg)
        self.rc = rc


def say(msg):
    print(f"deck-tools: {msg}")


def default_repo():
    return Path(__file__).resolve().parents[2]


def git(repo, *args, check=True):
    r = subprocess.run(["git", "-C", str(repo), *args], capture_output=True, timeout=60)
    if check and r.returncode != 0:
        raise Fail(f"git {' '.join(args)} failed in {repo}: {r.stderr.decode(errors='replace').strip()}", 2)
    return r


def in_git(repo):
    return git(repo, "rev-parse", "--is-inside-work-tree", check=False).returncode == 0


def sha256(data):
    return hashlib.sha256(data).hexdigest()


def mode_of(st_mode):
    return "100755" if st_mode & stat.S_IXUSR else "100644"


def parse_version(v, where):
    m = VERSION_RE.match(v or "")
    if not m:
        raise Fail(f"{where}: version must be MAJOR.MINOR.PATCH, got {v!r}", 2)
    return tuple(int(x) for x in m.groups())


# ---- the lock --------------------------------------------------------------------------------------------------

def parse_lock(text, where):
    meta, files, in_files = {}, {}, False
    for n, line in enumerate(text.splitlines(), 1):
        if not line.strip() or line.startswith("#"):
            continue
        if in_files:
            m = ENTRY_RE.match(line)
            if not m:
                raise Fail(f"{where}:{n}: expected '<mode> <sha256> <path>'", 2)
            mode, digest, path = m.groups()
            if not path.startswith(TOOLS_REL + "/") or ".." in path.split("/"):
                raise Fail(f"{where}:{n}: path outside {TOOLS_REL}/: {path}", 2)
            if path in files:
                raise Fail(f"{where}:{n}: duplicate path {path}", 2)
            files[path] = (mode, digest)
            continue
        if line == "files:":
            in_files = True
            continue
        m = re.match(r"^([a-z_]+): (.+)$", line)
        if not m:
            raise Fail(f"{where}:{n}: unexpected line", 2)
        meta[m.group(1)] = m.group(2)
    if meta.get("lock_format") != LOCK_FORMAT:
        raise Fail(f"{where}: lock_format must be {LOCK_FORMAT}", 2)
    for k in ("version", "source"):
        if k not in meta:
            raise Fail(f"{where}: no '{k}:' line", 2)
    parse_version(meta["version"], where)
    if not files:
        raise Fail(f"{where}: no files listed", 2)
    return meta, files


def render_lock(version, source, files):
    head = [f"lock_format: {LOCK_FORMAT}", f"version: {version}", f"source: {source}", "files:"]
    entries = [f"{m} {d} {p}" for p, (m, d) in sorted(files.items())]
    return LOCK_HEADER + "\n".join(head + entries) + "\n"


def read_lock(repo, index=False):
    where = f"{repo}/{LOCK_REL}" + (" (staged)" if index else "")
    if index:
        r = git(repo, "show", f":{LOCK_REL}", check=False)
        if r.returncode != 0:
            raise Fail(f"no {LOCK_REL} in the index of {repo}", 2)
        return parse_lock(r.stdout.decode(), where)
    p = Path(repo, LOCK_REL)
    if not p.is_file():
        raise Fail(f"no lock: {p} (run `deck-tools lock` in the origin repo or `deck-tools sync` here)", 2)
    return parse_lock(p.read_text(), where)


# ---- the files as they are -------------------------------------------------------------------------------------

def worktree_files(repo):
    """{path: (mode, sha256)} for every file under tools/deck-tools/; symlinks and specials are problems."""
    root = Path(repo, TOOLS_REL)
    found, problems = {}, []
    if not root.is_dir():
        raise Fail(f"no {TOOLS_REL}/ in {repo}", 2)
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = sorted(d for d in dirnames if d not in IGNORED_DIRS)
        for name in sorted(filenames):
            if name.endswith(IGNORED_SUFFIXES):
                continue
            p = Path(dirpath, name)
            rel = p.relative_to(repo).as_posix()
            st = os.lstat(p)
            if not stat.S_ISREG(st.st_mode):
                problems.append(f"not a regular file: {rel}")
                continue
            found[rel] = (mode_of(st.st_mode), sha256(p.read_bytes()))
    return found, problems


def index_files(repo):
    r = git(repo, "ls-files", "-s", "-z", "--", TOOLS_REL)
    found, problems = {}, []
    for rec in r.stdout.decode().split("\0"):
        if not rec:
            continue
        info, path = rec.split("\t", 1)
        mode, blob, _stage = info.split()
        if any(part in IGNORED_DIRS for part in path.split("/")) or path.endswith(IGNORED_SUFFIXES):
            continue
        if mode not in ("100755", "100644"):
            problems.append(f"not a regular file in the index (mode {mode}): {path}")
            continue
        data = git(repo, "cat-file", "blob", blob).stdout
        found[path] = (mode, sha256(data))
    return found, problems


def git_modes(repo):
    """{path: mode} as git records the tracked files under tools/deck-tools/ (empty outside git)."""
    if not in_git(repo):
        return {}
    r = git(repo, "ls-files", "-s", "-z", "--", TOOLS_REL)
    out = {}
    for rec in r.stdout.decode().split("\0"):
        if rec:
            info, path = rec.split("\t", 1)
            out[path] = info.split()[0]
    return out


def file_bytes(repo, rel, index):
    if index:
        return git(repo, "show", f":{rel}").stdout
    return Path(repo, rel).read_bytes()


def diff_files(locked, actual):
    problems = []
    for path, (mode, digest) in sorted(locked.items()):
        if path not in actual:
            problems.append(f"missing: {path}")
            continue
        amode, adigest = actual[path]
        if adigest != digest:
            problems.append(f"content differs from the lock: {path}")
        if amode != mode:
            what = "lost its executable bit" if mode == "100755" else "is executable but locked as 100644"
            problems.append(f"{path} {what} (lock {mode}, found {amode})")
    for path in sorted(set(actual) - set(locked)):
        problems.append(f"not in the lock: {path}")
    return problems


def check_release_files(repo, meta, files, index):
    problems = []
    vrel, crel = f"{TOOLS_REL}/VERSION", f"{TOOLS_REL}/CHANGELOG.md"
    if vrel in files:
        try:
            v = file_bytes(repo, vrel, index).decode().strip()
        except (OSError, Fail):
            v = None
        if v is not None and v != meta["version"]:
            problems.append(f"{vrel} says {v!r} but the lock says {meta['version']!r} (run `deck-tools lock`)")
    if crel in files:
        try:
            text = file_bytes(repo, crel, index).decode()
        except (OSError, Fail):
            text = None
        rx = re.compile(r"^## \[?" + re.escape(meta["version"]) + r"\]?(\s|$)", re.M)
        if text is not None and not rx.search(text):
            problems.append(f"{crel} has no '## {meta['version']}' entry")
    return problems


def verify(repo, index=False, base=None):
    meta, locked = read_lock(repo, index)
    if index:
        actual, problems = index_files(repo)
    else:
        actual, problems = worktree_files(repo)
    problems += diff_files(locked, actual)
    if not index:
        for path, mode in sorted(git_modes(repo).items()):
            if path in locked and mode != locked[path][0]:
                problems.append(f"git records {path} as {mode}, the lock says {locked[path][0]} "
                                f"(git update-index --chmod={'+x' if locked[path][0] == '100755' else '-x'})")
    problems += check_release_files(repo, meta, locked, index)
    if base:
        problems += check_base(repo, base, meta, locked)
    return meta, locked, problems


def check_base(repo, base, meta, locked):
    r = git(repo, "show", f"{base}:{LOCK_REL}", check=False)
    if r.returncode != 0:
        return []                                  # no lock at the base: nothing to compare with
    bmeta, bfiles = parse_lock(r.stdout.decode(), f"{base}:{LOCK_REL}")
    old, new = parse_version(bmeta["version"], "base"), parse_version(meta["version"], "lock")
    if new < old:
        return [f"version went down: {bmeta['version']} at {base}, {meta['version']} now"]
    if bfiles != locked and new == old:
        changed = sorted(p for p in set(bfiles) | set(locked) if bfiles.get(p) != locked.get(p))
        return [f"locked files changed since {base} ({', '.join(changed)}) but the version is still "
                f"{meta['version']}: bump {TOOLS_REL}/VERSION, add a CHANGELOG.md entry, run `deck-tools lock`"]
    return []


# ---- commands ----------------------------------------------------------------------------------------------------

def cmd_verify(a):
    meta, locked, problems = verify(a.repo, index=a.index, base=a.base)
    if problems:
        for p in problems:
            print(f"deck-tools verify: {p}", file=sys.stderr)
        print(f"deck-tools verify: FAILED ({len(problems)} problem(s); lock version {meta['version']})", file=sys.stderr)
        return 1
    if not a.quiet:
        say(f"verify OK (version {meta['version']}, {len(locked)} files{', staged' if a.index else ''})")
    return 0


def cmd_lock(a):
    repo = a.repo
    vfile = Path(repo, TOOLS_REL, "VERSION")
    if not vfile.is_file():
        raise Fail(f"no {vfile}", 2)
    version = vfile.read_text().strip()
    parse_version(version, str(vfile))
    lock = Path(repo, LOCK_REL)
    if lock.is_file() and not a.force:
        meta, _ = parse_lock(lock.read_text(), str(lock))
        if meta["source"] != "origin":
            raise Fail(f"{lock} is a vendored copy (source: {meta['source']}); change the origin and "
                       f"`deck-tools sync` instead (or --force)")
    files, problems = worktree_files(repo)
    if problems:
        raise Fail("; ".join(problems))
    text = render_lock(version, "origin", files)
    old = lock.read_text() if lock.is_file() else None
    if old == text:
        say(f"lock unchanged (version {version}, {len(files)} files)")
        return 0
    lock.write_text(text)
    say(f"wrote {LOCK_REL} (version {version}, {len(files)} files)")
    return 0


def source_identity(src, allow_dirty):
    if not in_git(src):
        if not allow_dirty:
            raise Fail(f"{src} is not a git checkout, so the release cannot be identified (--allow-dirty to "
                       f"copy it anyway)")
        return "unidentified (not a git checkout)"
    commit = git(src, "rev-parse", "HEAD").stdout.decode().strip()
    dirty = git(src, "status", "--porcelain", "--", TOOLS_REL, LOCK_REL).stdout.strip()
    if dirty and not allow_dirty:
        raise Fail(f"{src} has uncommitted changes under {TOOLS_REL}/ or in {LOCK_REL} (commit them, or "
                   f"--allow-dirty)")
    tag = git(src, "describe", "--tags", "--exact-match", "--match", "deck-tools-v*", "HEAD", check=False)
    tag = tag.stdout.decode().strip() if tag.returncode == 0 else "untagged"
    return f"local-inference-deck {tag} {commit}" + (" +uncommitted" if dirty else "")


def cmd_sync(a):
    src, repo = Path(a.src).resolve(), a.repo
    if not src.is_dir():
        raise Fail(f"--from: not a directory: {src}", 2)
    if src == repo.resolve():
        raise Fail("--from is this repo; sync copies a release from another checkout", 2)
    smeta, sfiles, problems = verify(src)
    if problems:
        raise Fail(f"the source {src} does not match its own lock: " + "; ".join(problems))
    source = source_identity(src, a.allow_dirty)
    dst_root = Path(repo, TOOLS_REL)
    dst_root.mkdir(parents=True, exist_ok=True)
    before = {}
    if dst_root.is_dir():
        before, _ = worktree_files(repo)
    for rel, (mode, digest) in sorted(sfiles.items()):
        data = Path(src, rel).read_bytes()
        if sha256(data) != digest:                      # changed under us since verify
            raise Fail(f"{src}/{rel} changed during the sync", 1)
        dst = Path(repo, rel)
        dst.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=dst.parent, prefix=".deck-tools-sync.")
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        os.chmod(tmp, 0o755 if mode == "100755" else 0o644)
        os.replace(tmp, dst)
    removed = sorted(set(before) - set(sfiles))
    for rel in removed:
        Path(repo, rel).unlink()
    for dirpath, dirnames, filenames in os.walk(dst_root, topdown=False):
        if dirpath != str(dst_root) and not os.listdir(dirpath):
            os.rmdir(dirpath)
    Path(repo, LOCK_REL).write_text(render_lock(smeta["version"], source, sfiles))
    added = sorted(set(sfiles) - set(before))
    changed = sorted(p for p in set(sfiles) & set(before) if before[p] != sfiles[p])
    say(f"synced version {smeta['version']} from {source}: {len(added)} added, {len(changed)} changed, "
        f"{len(removed)} removed")
    for label, names in (("added", added), ("changed", changed), ("removed", removed)):
        for n in names:
            print(f"  {label:8} {n}")
    _, _, problems = verify(repo)
    if problems:
        raise Fail("verify after sync failed: " + "; ".join(problems))
    say(f"commit {TOOLS_REL}/ and {LOCK_REL} together")
    return 0


def cmd_install_hooks(a):
    repo = a.repo
    if not in_git(repo):
        raise Fail(f"{repo} is not a git work tree", 2)
    top = Path(git(repo, "rev-parse", "--show-toplevel").stdout.decode().strip())
    if not any(Path(top, h).is_file() for h in ("hooks/pre-commit", f"{TOOLS_REL}/pre-commit")):
        raise Fail(f"neither hooks/pre-commit nor {TOOLS_REL}/pre-commit in {top}", 2)
    hp = git(repo, "config", "--get", "core.hooksPath", check=False).stdout.decode().strip()
    if hp:
        hdir = Path(hp).expanduser()
        hdir = hdir if hdir.is_absolute() else top / hdir
        if hdir.resolve() == (top / "hooks").resolve() and (top / "hooks/pre-commit").is_file():
            say(f"pre-commit already wired: core.hooksPath={hp} runs hooks/pre-commit")
            return 0
        raise Fail(f"core.hooksPath is set to {hp}; unset it (git config --unset core.hooksPath) and rerun, or "
                   f"call hooks/pre-commit from the hook there yourself")
    common = Path(git(repo, "rev-parse", "--git-common-dir").stdout.decode().strip())
    common = common if common.is_absolute() else top / common
    target = common / "hooks" / "pre-commit"
    if target.exists() or target.is_symlink():
        if target.is_symlink() and target.exists() and target.resolve().name == "pre-commit" \
                and target.resolve().parent.name == "hooks" and HOOK_MARKER not in target.read_text(errors="replace"):
            # the CONVENTIONS.md symlink to a checkout's hooks/pre-commit: also fine, leave it
            say(f"pre-commit already wired: {target} -> {os.readlink(target)}")
            return 0
        cur = target.read_text(errors="replace") if target.exists() else ""
        if HOOK_MARKER in cur:
            if cur == HOOK_STUB:
                say(f"pre-commit already installed: {target}")
                return 0
        elif not a.force:
            raise Fail(f"{target} exists and is not ours; keep it, or rerun with --force "
                       f"(it is saved as pre-commit.pre-deck-tools)")
        else:
            backup = target.with_name("pre-commit.pre-deck-tools")
            os.replace(target, backup)
            say(f"saved the old hook as {backup}")
    target.parent.mkdir(parents=True, exist_ok=True)
    tmp = target.with_name(".pre-commit.deck-tools")
    tmp.write_text(HOOK_STUB)
    os.chmod(tmp, 0o755)
    os.replace(tmp, target)
    say(f"installed {target}: runs the committing work tree's hooks/pre-commit")
    return 0


def cmd_version(a):
    meta, _ = read_lock(a.repo)
    print(meta["version"])
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="deck-tools", description=__doc__.split("\n\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    def add(name, fn):
        sp = sub.add_parser(name)
        sp.add_argument("--repo", type=Path, default=None, help="repo root (default: the one vendoring this file)")
        sp.set_defaults(fn=fn)
        return sp

    sp = add("verify", cmd_verify)
    sp.add_argument("--index", action="store_true", help="check the staged files and lock")
    sp.add_argument("--base", metavar="REV", help="also require a version bump when the files changed since REV")
    sp.add_argument("--quiet", "-q", action="store_true", help="print nothing when everything matches")
    sp = add("lock", cmd_lock)
    sp.add_argument("--force", action="store_true", help="rewrite a vendored copy's lock as the origin")
    sp = add("sync", cmd_sync)
    sp.add_argument("--from", dest="src", required=True, metavar="DIR", help="a local-inference-deck checkout")
    sp.add_argument("--allow-dirty", action="store_true", help="copy even with uncommitted changes in DIR")
    sp = add("install-hooks", cmd_install_hooks)
    sp.add_argument("--force", action="store_true", help="replace a different existing pre-commit hook")
    add("version", cmd_version)
    a = p.parse_args(argv)
    a.repo = (a.repo or default_repo()).absolute()
    if not a.repo.is_dir():
        print(f"deck-tools: --repo: not a directory: {a.repo}", file=sys.stderr)
        return 2
    try:
        return a.fn(a)
    except Fail as e:
        print(f"deck-tools: {e}", file=sys.stderr)
        return e.rc


if __name__ == "__main__":
    sys.exit(main())
