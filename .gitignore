# secrets — never commit
.htpasswd
api_key
*.key

# live wireguard configs (only .example files should be committed)
wireguard/*.conf
!wireguard/*.conf.example

# live nginx config with real bearer token
nginx/spark.live.conf

# editor / OS noise
*.swp
*.swo
.DS_Store
.idea/
.vscode/
site.env
*.env
!*.env.example
secrets/
*.key
*.pem
.sanitize-extra
.sanitize-words

# python bytecode
__pycache__/
*.pyc
.pytest_cache/
site.env.bak-*

# evals: the harness moved to the sec-evals repo (evals/README.md). Checkouts made before the split still hold
# its gitignored benchmark data and run results here (a rollback to pre-split-3 runs gates with them); they must
# never be committed, so the patterns stay.
evals/data/
evals/results/
