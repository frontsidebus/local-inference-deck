# Copy to site.env (gitignored) and fill in. See CONVENTIONS.md.
# --- identity / DNS
SPARK_DOMAIN=example.com
SPARK_CHAT_HOST=chat.example.com
SPARK_API_HOST=api.example.com
SPARK_ID_HOST=id.example.com
SPARK_TELEMETRY_HOST=telemetry.example.com
SPARK_DIGEST_HOST=digest.example.com
LETSENCRYPT_EMAIL=admin@example.com
ADMIN_EMAIL=admin@example.com            # Open WebUI break-glass local admin
# --- network
EDGE_PUBLIC_IP=203.0.113.10              # edge Elastic IP (TEST-NET-3 example)
EDGE_WG_IP=10.100.0.1
BACKEND_WG_IP=10.100.0.2
WG_PORT=51820
BACKEND_LAN_IP=192.168.122.10            # backend VM address on the hypervisor bridge
HYPERVISOR_BRIDGE_IP=192.168.122.1       # where the workstation hermes-gateway listens
ADMIN_SOURCE_IPS=198.51.100.7            # trusted admin IP(s): fail2ban ignoreip, setup locks (space-separated)
GATEWAY_DOCKER_SUBNET=172.30.40.0/24
# --- backend paths / users
MODELS_DIR=/models
BACKEND_SSH_USER=operator
# --- access
SPARK_USERS="alice bob"                  # one LiteLLM key + Pocket-ID account each
HARNESS_KEYS="claude-code codex hermes opencode open-webui"
TELEMETRY_GROUP=telemetry-viewers
DIGEST_GROUP=digest-viewers
CHAT_GROUP=chat-users
# --- covenant (edge)
WG_SUBNET=10.100.0.0/24                  # tunnel subnet; fail2ban ignoreip on the edge
WG_BACKEND_PUBLIC_KEY=CHANGEME           # backend's WireGuard public key (wg pubkey < its privatekey); peer in edge wg0.conf
WEBUI_PORT=3000                          # backend ports on BACKEND_WG_IP that edge nginx proxies to: Open WebUI (chat.)
POCKETID_PORT=1411                       #   Pocket-ID (id.)
LITELLM_PORT=4000                        #   LiteLLM (api.)
TELEMETRY_PORT=3200                      #   telemetry app (telemetry.)
DIGEST_PORT=3300                         #   digest app (digest.)
OAUTH2_PROXY_CLIENT_ID=telemetry         # Pocket-ID OIDC client id used by oauth2-proxy for telemetry.
OAUTH2_PROXY_DIGEST_CLIENT_ID=digest     # Pocket-ID OIDC client id used by oauth2-proxy for digest.
# --- walter (backend)
SPARK_SITE_NAME="spark"                  # display name in the telemetry dashboard header
MODELS_FS_UUID=CHANGEME                  # `blkid -s UUID -o value <models disk>`: XFS fs mounted at MODELS_DIR (fstab, nofail)
BACKEND_LAN_IF=enp1s0                    # backend NIC on the hypervisor bridge (docker-user-rules drops published ports here)
WG_EDGE_PUBLIC_KEY=CHANGEME              # edge's WireGuard public key (wg pubkey < its privatekey); peer in backend wg0.conf
RESTIC_BUCKET=""                         # offsite backups (walter/backup/OFFSITE.md): S3 bucket for restic; empty = off
RESTIC_REGION=us-east-1                  #   its region (repo s3:s3.<region>.amazonaws.com/<bucket>/walter)
# --- clients (workstation)
HERMES_GATEWAY_PORT=8642                 # optional workstation hermes-gateway port on HYPERVISOR_BRIDGE_IP (Open WebUI "Hermes Agent")
# --- judge (judge/: reviewer for the local agent; see judge/README.md)
JUDGE_MODE=frontier                      # frontier (claude CLI: infra-class evidence; claims-only bundles of sensitive completions) | local (gateway alias below)
JUDGE_LOCAL_MODEL=big                    # gateway alias for the local judge (sensitive data, over the daily cap); recommended: vision (different family than the worker)
                                         # the workstation runs coder-fast (already loaded, no eviction) with the medium cap and no injection: judge/README.md "Policy as deployed"
JUDGE_FRONTIER_CMD=claude                # frontier CLI, run with gateway endpoint variables stripped
JUDGE_FRONTIER_DAILY_MAX=20              # frontier calls per UTC day before falling back to the local judge (each sensitive completion adds a claims-stage call: consider 40)
JUDGE_FRONTIER_MAX_USD=2                 # per-call budget passed to the frontier CLI
JUDGE_SSH_ALIASES="edge-alias"           # ssh aliases that should reach the edge (space-separated); gate + probes
EDGE_SSH_USER=ubuntu                     # login user on the edge, for read-only probes
EDGE_SSH_KEY=~/.ssh/edge.pem             # key for EDGE_SSH_USER (path only; the key never enters the repo)
JUDGE_RUNAWAY_TOKENS=24000               # C6: alert when a slot has decoded this many tokens, whatever its n_predict cap
JUDGE_RUNAWAY_MINUTES=10                 # C6: ...or a single call has run this long
JUDGE_PROBE_TIMEOUT=20                   # seconds per read-only probe step (judge/probes/probe.py)
JUDGE_SSH_CONNECT_TIMEOUT=8              # ssh ConnectTimeout for collector/probes (BatchMode, never prompts)
JUDGE_INFRA_REPOS=""                     # extra repo dirs whose files count as infra-class (space-separated; this repo always does)
JUDGE_LOG_TZ=""                          # zone of Hermes log timestamps: empty = workstation local, UTC, +02:00 or an IANA name
JUDGE_COMPLETION_DEDUPE_SECONDS=900      # completion requests of one session within this window, same/fewer paths, are dropped
JUDGE_WINDOW_GRACE_SECONDS=10            # evidence window ends at request.created + this, never past the next turn's start; the runner waits until created + this + 3 s before collecting
JUDGE_HOST_PROBES=1                      # 1 = collector probes host units/ports named in claims (read-only, max 4); 0 = off
JUDGE_NOISE_GLOBS=""                     # extra globs (absolute paths) of bookkeeping files that never count as a change
JUDGE_LOG_NOISE_LOGGERS=""               # extra untagged Hermes loggers (name or prefix.*) dropped from hermes-log.txt context
JUDGE_SNAPSHOT_MAX_FILES=2000            # per opted-in (JUDGE_INFRA_REPOS, non-git) dir: files snapshotted at session start
JUDGE_SNAPSHOT_MAX_BYTES=1048576         # per file: larger files in an opted-in dir are hashed, not copied
JUDGE_LOCAL_MAX_SEVERITY=medium          # cap on local-judge item severity (low|medium|high)
JUDGE_INJECT_LOCAL=0                     # 1 = C5 also shows local-judge findings to the agent
JUDGE_SENSITIVE_FRONTIER_CLAIMS=1        # 1 = sensitive completions also get a frontier review of a claims-only bundle (final answer + gate/C3/tool metadata, no contents/paths); counts against JUDGE_FRONTIER_DAILY_MAX; 0 = local only
JUDGE_REVIEW_TEXT_ONLY=1                 # 1 = a turn with no tool calls is still reviewed when its final answer is substantive and claims actions/state/verification (or the gate decided something); 0 = never
JUDGE_REVIEW_TEXT_ONLY_MIN_CHARS=200     # ...the final answer must be at least this long
JUDGE_REVIEW_TEXT_ONLY_REQUIRE_CLAIMS=1  # ...and contain a claim word (done/fixed/blocked/ran/verified/escalated/...); 0 = every substantive answer
JUDGE_LOCAL_MAX_TOKENS=4096              # output cap of every local judge call
JUDGE_LOCAL_RETRY_MAX_TOKENS=8192        # output cap of the re-ask after a reply was cut off at the cap (default 2x, never less); noted in the finding
# JUDGE_ACK_AGENT_ENV=""                # env only (site.env is not read for it): extra agent-session env names for judge-ack, comma-separated
