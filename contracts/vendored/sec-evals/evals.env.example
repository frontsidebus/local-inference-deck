# evals.env.example: the site.env keys sec-evals reads. Example values only; never commit real ones.
#
# These are the keys that local-inference-deck's registry (contracts/site-keys.yaml) lists with "evals" among
# their consumers, with the registry's example defaults copied exactly. The deck owns the registry and keeps
# site.env.example as the documented union; this file is sec-evals' own example baseline for
# scripts/check-sanitized.sh and the list the deck's C1 coverage test compares against its registry.
#
# Where they are read:
#   evals/run.py (setting / load_site_env): SPARK_API_HOST (the edge gateway base URL)
#   evals/gate.py: BACKEND_LAN_IP, BACKEND_SSH_USER (live llama-swap snapshot, GPU guard), BACKEND_WG_IP (tunnel)
#   evals/tools/lib.sh site_value (gpu-guard.sh, gateway-tunnel.sh): BACKEND_LAN_IP, BACKEND_SSH_USER,
#     BACKEND_WG_IP, LITELLM_PORT
#
# The real file is the operator's site.env. In a sec-evals checkout, `deck install evals` (run from the deck)
# creates the gitignored <sec-evals>/site.env symlink to it, which run.py's --site-env default reads. The tools
# also honour $SITE_ENV and ~/.config/deck/site.env (lib.sh), and `deck evals` passes --site-env.
#
# Not registry keys: EVAL_GPU_SSH and EVAL_GATEWAY are process-environment overrides.
# EVAL_BASE_URL and SPARK_EVAL_KEY_FILE are optional registry keys (deck PR #90), read from the environment
# first, then site.env (run.py setting); unset by default.
SPARK_API_HOST=api.example.com
BACKEND_WG_IP=10.100.0.2
BACKEND_LAN_IP=192.168.122.10
BACKEND_SSH_USER=operator
LITELLM_PORT=4000
# EVAL_BASE_URL=""                      # gateway URL for run.py/gate.py (e.g. http://127.0.0.1:<port>/v1); empty = https://${SPARK_API_HOST}/v1, gate.py: an SSH tunnel
# SPARK_EVAL_KEY_FILE=""                # gateway key file for the eval runner; empty = ~/.config/spark/hermes.key
