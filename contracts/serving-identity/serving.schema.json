{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/serving-identity/serving.schema.json",
  "title": "spark-model-agent serving --json (C4, owner: local-inference-deck)",
  "description": "What the backend's live llama-swap config serves, as hashes. Read by the eval gate (evals/gate.py live_snapshot). contract_version 1.0: minor = an added optional field; major = a renamed, removed or re-meant field. No cmd text, paths or keys may appear.",
  "contract_version": "1.0",
  "type": "object",
  "required": ["ok", "verb", "config", "config_sha256", "models"],
  "properties": {
    "ok": {"type": "boolean"},
    "verb": {"const": "serving"},
    "config": {"type": "string"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "error": {"type": "string"},
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["aliases", "name", "cmd_sha256", "server_flags"],
        "additionalProperties": false,
        "properties": {
          "aliases": {"type": "array", "items": {"type": "string"}},
          "name": {"type": "string"},
          "cmd_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "server_flags": {"type": "object", "additionalProperties": {"type": "string"}}
        }
      }
    }
  }
}
